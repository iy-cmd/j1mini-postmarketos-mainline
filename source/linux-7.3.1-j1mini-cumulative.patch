 {
 	unsigned int val;
@@ -1154,6 +1252,12 @@ static int smb347_get_property_locked(struct power_supply *psy,
 		val->intval = ret;
 		break;
 
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
