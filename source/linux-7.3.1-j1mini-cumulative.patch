+	.dapm_widgets = sc2723_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(sc2723_dapm_widgets),
+	.dapm_routes = sc2723_dapm_routes,
+	.num_dapm_routes = ARRAY_SIZE(sc2723_dapm_routes),
+	.idle_bias_on = false,
+	.use_pmdown_time = true,
+	.endianness = 1,
+};
