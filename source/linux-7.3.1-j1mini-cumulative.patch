diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
new file mode 100644
index 000000000..3333a0aef
--- /dev/null
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
@@ -0,0 +1,690 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab E 9.6 WiFi (SM-T560, "gtelwifi")
+ *
+ * Panel: Novatek NT51017 (BOE), 800x1280 MIPI DSI video mode, native
+ * portrait. Touch: Zinitix ZT7554 on I2C. Charger: SMB358.
+ */
+
+/dts-v1/;
+
+#include "sc7730.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/power/summit,smb347-charger.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	/* Touch supply: a GPIO-switched 3.3 V rail, not a PMIC LDO */
+	tsp_ldo: regulator-tsp {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp_ldo";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio 156 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <200000>;	/* vendor waits 200 ms */
+	};
+
+	/*
+	 * Bit-banged bus to the SMB358 charger, as in the vendor tree; sboot
+	 * drives the same pins and leaves them muxed as GPIO.
+	 */
+	i2c-chg {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpio 159 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpio 160 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <10>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/*
+		 * sboot leaves a 4.35 V float, charging on, termination off.
+		 * The vendor kernel set 4.32 V; smb347 rewrites only what is
+		 * given here (volatile copies, reloaded from NVM at POR).
+		 * No temperature properties: those would switch on the
+		 * chip's NTC monitor, which the vendor keeps off (0x07 bit 4).
+		 */
+		charger: charger@6a {
+			compatible = "summit,smb358";
+			reg = <0x6a>;
+			/* without it, "online" stays at its probe-time value */
+			interrupts-extended = <&gpio 161 IRQ_TYPE_EDGE_FALLING>;
+			summit,enable-usb-charging;
+			summit,enable-charge-control = <SMB3XX_CHG_ENABLE_SW>;
+			summit,fast-voltage-threshold-microvolt = <2400000>;
+			/*
+			 * High-current input mode by the MUIC's charger type:
+			 * 1.8 A on a wall charger (vendor value), 1.5 A on a
+			 * charging host port, 500 mA on a plain one.
+			 */
+			extcon = <&muic>;
+			summit,mains-current-limit-microamp = <1800000>;
+			monitored-battery = <&battery>;
+		};
+	};
+
+	/*
+	 * Power (PBINT) and Volume Down (EXT_RSTN) are PMIC inputs, not part
+	 * of the keypad matrix. Power + Volume Down held for ~7-10 s is a
+	 * hardware reset in the PMIC, independent of the kernel. The EIC
+	 * debounces in hardware, 50 ms as the bootloader sets it.
+	 */
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "gtelwifi";
+		simple-audio-card,widgets = "Speaker", "Speaker",
+					    "Headphone", "Headphones",
+					    "Microphone", "Internal Mic";
+		simple-audio-card,routing = "Speaker", "SPK",
+					    "Headphones", "HPOL",
+					    "Headphones", "HPOR",
+					    "MIC", "Internal Mic";
+		simple-audio-card,pin-switches = "Speaker", "Headphones";
+		/* jack switch, low with a plug in (vendor headset detect) */
+		simple-audio-card,hp-det-gpios = <&gpio 237 GPIO_ACTIVE_LOW>;
+
+		simple-audio-card,cpu {
+			sound-dai = <&vbc>;
+		};
+
+		simple-audio-card,plat {
+			sound-dai = <&audio_pcm>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&sc2723_codec>;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		key-power {
+			label = "Power";
+			gpios = <&pmic_eic 2 GPIO_ACTIVE_HIGH>;
+			linux,code = <KEY_POWER>;
+			debounce-interval = <50>;
+			wakeup-source;
+		};
+
+		key-volume-down {
+			label = "Volume Down";
+			gpios = <&pmic_eic 10 GPIO_ACTIVE_HIGH>;
+			linux,code = <KEY_VOLUMEDOWN>;
+			debounce-interval = <50>;
+		};
+	};
+
+	/*
+	 * BCM43430 A1: WL_REG_ON is GPIO 230 (high = on, vendor waits 200 ms),
+	 * its 32 kHz LPO comes from CLK_AUX0. Host wake (GPIO 148, level high)
+	 * is not used yet, interrupts come in-band over SDIO.
+	 */
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&gpio 230 GPIO_ACTIVE_LOW>;
+		clocks = <&clk_aux0>;
+		clock-names = "ext_clock";
+		post-power-on-delay-ms = <200>;
+	};
+
+	/*
+	 * SC2723 fuel gauge (mach-sprd/sc2723-fgu.c). Sense resistor: 20 mOhm
+	 * nominal, 20.2 mOhm on this board (vendor rsense_real = 202).
+	 */
+	fuel-gauge {
+		compatible = "sprd,sc2723-fgu-polled";
+		monitored-battery = <&battery>;
+		power-supplies = <&charger>;
+		sprd,calib-resistance-micro-ohms = <20200>;
+		/* battery thermistor, vendor sec-battery table (ADC -> 0.1 C) */
+		io-channels = <&pmic_adc 1>;
+		io-channel-names = "bat-temp";
+		sprd,bat-temp-table = <653 700>, <889 600>, <963 580>,
+			<1093 530>, <1177 500>, <1307 460>, <1334 450>,
+			<1549 400>, <1940 300>, <2392 200>, <2727 100>,
+			<2900 50>, <3040 0>, <3210 (-50)>, <3360 (-100)>,
+			<3537 (-200)>;
+		/* vendor limits: stop charging at -5 / 58 C, resume at 0 / 53 C */
+		sprd,charge-stop-celsius = <(-5) 58>;
+		sprd,charge-resume-celsius = <0 53>;
+	};
+
+	/*
+	 * Bit-banged bus to the SM5504 MUIC, which tells USB host ports
+	 * (SDP/CDP) from wall chargers (DCP) for the charger's input limit.
+	 * The bootloader leaves it in automatic switching, the USB data
+	 * path does not depend on the driver.
+	 */
+	i2c-muic {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpio 150 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpio 151 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <10>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		muic: extcon@14 {
+			compatible = "siliconmitus,sm5504-muic";
+			reg = <0x14>;
+			interrupt-parent = <&gpio>;
+			interrupts = <149 IRQ_TYPE_EDGE_FALLING>;
+		};
+	};
+
+	/* 5000 mAh, data from the vendor sec-fuelgauge/sec-battery nodes */
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion";
+		charge-full-design-microamp-hours = <5000000>;
+		constant-charge-voltage-max-microvolt = <4320000>;
+		constant-charge-current-max-microamp = <2000000>;
+		precharge-current-microamp = <450000>;
+		charge-term-current-microamp = <200000>;
+		factory-internal-resistance-micro-ohms = <220000>;
+		voltage-min-design-microvolt = <3400000>;
+		ocv-capacity-celsius = <20>;
+		ocv-capacity-table-0 = <4320000 100>, <4262000 95>, <4205000 90>,
+			<4152000 85>, <4101000 80>, <4055000 75>, <4006000 70>,
+			<3968000 65>, <3923000 60>, <3880000 55>, <3849000 50>,
+			<3824000 45>, <3806000 40>, <3790000 35>, <3778000 30>,
+			<3770000 25>, <3761000 20>, <3744000 15>, <3711000 10>,
+			<3690000 5>, <3400000 0>;
+	};
+};
+
+/*
+ * Zinitix ZT7554 (vendor "zinitix,zt7554_ts"); pinmux for I2C1 and the
+ * IRQ pad comes from the bootloader. GPIOs 81/83 only tell the vendor
+ * driver which firmware image to flash. The two capacitive keys next to
+ * Home are touch controller icons 0 and 1 (vendor: KEY_RECENT, KEY_BACK).
+ */
+&i2c1 {
+	status = "okay";
+
+	touchscreen@20 {
+		compatible = "zinitix,bt554";
+		reg = <0x20>;
+		interrupt-parent = <&gpio>;
+		interrupts = <82 IRQ_TYPE_EDGE_FALLING>;
+		vcca-supply = <&tsp_ldo>;
+		touchscreen-size-x = <800>;
+		touchscreen-size-y = <1280>;
+		linux,keycodes = <KEY_APPSELECT KEY_BACK>;
+	};
+};
+
+/ {
+	model = "Samsung Galaxy Tab E 9.6 (SM-T560)";
+	compatible = "samsung,gtelwifi", "sprd,sc7730";
+
+	/*
+	 * Board id the Spreadtrum bootloader matches against dt.img.
+	 * The build script generates one copy per hardware revision.
+	 */
+	sprd,sc-id = <8830 11 0x20000>;
+
+	/* fixed host numbers: the eMMC must stay mmcblk0 (init, tabflash) */
+	aliases {
+		mmc0 = &emmc;
+		mmc1 = &sdio1;
+		mmc2 = &sdio0;
+		serial0 = &uart0;
+		serial1 = &uart1;
+		serial3 = &uart3;
+	};
+
+	chosen {
+		/* The bootloader rewrites this, the kernel appends its own */
+		bootargs = "";
+	};
+
+	/* The bootloader patches the real size in */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x60000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		smem@87800000 {
+			reg = <0x87800000 0x240000>;
+			no-map;
+		};
+
+		cp-modem@88000000 {
+			reg = <0x88000000 0x1c00000>;
+			no-map;
+		};
+
+		/* vendor kernel framebuffer, also our fallback scan-out */
+		framebuffer@9ea44000 {
+			reg = <0x9ea44000 0xbb8000>;
+			no-map;
+		};
+
+		/*
+		 * Kernel log survives a warm reboot here. Lies inside the area
+		 * the vendor kernel reserves for ION, so TWRP will not touch it.
+		 */
+		ramoops@9fc00000 {
+			compatible = "ramoops";
+			reg = <0x9fc00000 0x100000>;
+			record-size = <0x20000>;
+			console-size = <0x40000>;
+			pmsg-size = <0x20000>;
+		};
+
+		/*
+		 * Scan-out and GPU buffers for DISPC, which has no IOMMU, and the
+		 * camera buffers (DCAM has none either: a 2576x1932 still is
+		 * 7.5 MB in NV12, libcamera queues four plus the driver's
+		 * scratch frame). Kept in lowmem below the vendor's carve-outs,
+		 * where all vendor display buffers lived.
+		 */
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x8000000>;
+			alloc-ranges = <0x90000000 0xe000000>;
+			linux,cma-default;
+		};
+	};
+
+	/* Scan-out buffer left running by the bootloader (lcd_base=9ea44000) */
+	framebuffer@9ea44000 {
+		compatible = "simple-framebuffer";
+		reg = <0x9ea44000 (800 * 1280 * 4)>;
+		width = <800>;
+		height = <1280>;
+		stride = <(800 * 4)>;
+		format = "x8r8g8b8";	/* verified on the panel, Test 1b */
+		backlight = <&backlight>;
+	};
+
+	/*
+	 * PWM3 into the RT8555 LED driver (i2c-gpio 65/66 @ 0x31, EN GPIO
+	 * 155), which the bootloader sets up and leaves enabled; brightness
+	 * 0 is the vendor's off state. 20.4 kHz like the vendor, duty 143
+	 * as the bootloader leaves it.
+	 */
+	/* SC2723 LDO_SDCORE: microSD VDD and the SD0 pads (3 V mode only) */
+	vddsdcore: regulator-vddsdcore {
+		compatible = "sprd,sc2723-ldo";
+		regulator-name = "vddsdcore";
+		sprd,pd-reg = <0x814 10>;
+		sprd,vsel-reg = <0x830 0xff00>;
+		/* min = max: the core sets 3.0 V at registration */
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+	};
+
+	/* SC2723 camera LDOs: analog 2.8 V and I/O 1.8 V for both sensors */
+	vddcama: regulator-vddcama {
+		compatible = "sprd,sc2723-ldo";
+		regulator-name = "vddcama";
+		sprd,pd-reg = <0x814 4>;
+		sprd,vsel-reg = <0x830 0xff>;
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+	};
+
+	vddcamio: regulator-vddcamio {
+		compatible = "sprd,sc2723-ldo";
+		regulator-name = "vddcamio";
+		sprd,pd-reg = <0x814 6>;
+		sprd,vsel-reg = <0x81c 0x7f00>;
+		sprd,min-microvolt = <1150000>;
+		sprd,step-microvolt = <6250>;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+	};
+
+	/* rear camera autofocus actuator, 2.8 V; 0x834[15:8] is the eMMC core */
+	vddcammot: regulator-vddcammot {
+		compatible = "sprd,sc2723-ldo";
+		regulator-name = "vddcammot";
+		sprd,pd-reg = <0x814 7>;
+		sprd,vsel-reg = <0x834 0xff>;
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+	};
+
+	/* external 1.2 V core supply of the rear camera */
+	cam_dvdd: regulator-cam-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_dvdd";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		gpio = <&gpio 193 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <1000>;
+	};
+
+	/*
+	 * Broadcom BCM47520 GPS (vendor "broadcom,bcm47520"): a hosted GNSS on
+	 * UART3, the position engine is the proprietary glgps daemon. The
+	 * vendor driver turned on LDO_CAMD (1.8 V) and the TCXO supply LDO_SDIO
+	 * (3.3 V, nothing else on it) at probe and left GPS_PWR_EN (GPIO 168,
+	 * nStandby) to glgps through a sysfs file. Here LDO_CAMD stays on, and
+	 * the TCXO supply and GPS_PWR_EN switch together through a regulator
+	 * output whose "state" file glgps writes 1/0 to (GpioNStdbyPath, it
+	 * waits 250 ms after power-up).
+	 */
+	vddcamd: regulator-vddcamd {
+		compatible = "sprd,sc2723-ldo";
+		regulator-name = "vddcamd";
+		sprd,pd-reg = <0x814 5>;
+		sprd,vsel-reg = <0x81c 0x7f>;
+		sprd,min-microvolt = <1150000>;
+		sprd,step-microvolt = <6250>;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	vddsdio: regulator-vddsdio {
+		compatible = "sprd,sc2723-ldo";
+		regulator-name = "vddsdio";
+		sprd,pd-reg = <0x814 0>;
+		sprd,vsel-reg = <0x828 0xff>;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+	};
+
+	gps_pwr_en: regulator-gps-pwr-en {
+		compatible = "regulator-fixed";
+		regulator-name = "gps_pwr_en";
+		gpio = <&gpio 168 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vddsdio>;
+	};
+
+	gps-power {
+		compatible = "regulator-output";
+		vout-supply = <&gps_pwr_en>;
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm 3 49039 0>;
+		/*
+		 * Vendor curve (sprd-scx35_gtelwifi_rev10.dts backlight-brt-range,
+		 * sprd_pwm_bl.c): 0 off, 1-5 -> duty 3 (MIN), 10 -> 14 (DIM),
+		 * 162 -> 122 (DEF), 255 -> 255, linear in between. A plain 0..255
+		 * ramp left the lowest Android levels below the duty at which the
+		 * RT8555 LED driver lights the panel (screen black at minimum).
+		 */
+		brightness-levels = <
+			  0   3   3   3   3   3   6   8  10  12  14  15  16  17  17  18
+			 19  19  20  21  22  22  23  24  24  25  26  27  27  28  29  29
+			 30  31  32  32  33  34  34  35  36  37  37  38  39  39  40  41
+			 41  42  43  44  44  45  46  46  47  48  49  49  50  51  51  52
+			 53  54  54  55  56  56  57  58  59  59  60  61  61  62  63  64
+			 64  65  66  66  67  68  68  69  70  71  71  72  73  73  74  75
+			 76  76  77  78  78  79  80  81  81  82  83  83  84  85  86  86
+			 87  88  88  89  90  91  91  92  93  93  94  95  95  96  97  98
+			 98  99 100 100 101 102 103 103 104 105 105 106 107 108 108 109
+			110 110 111 112 113 113 114 115 115 116 117 118 118 119 120 120
+			121 122 122 124 125 127 128 130 131 133 134 135 137 138 140 141
+			143 144 145 147 148 150 151 153 154 155 157 158 160 161 163 164
+			165 167 168 170 171 173 174 175 177 178 180 181 183 184 185 187
+			188 190 191 193 194 195 197 198 200 201 203 204 205 207 208 210
+			211 213 214 215 217 218 220 221 223 224 225 227 228 230 231 233
+			234 235 237 238 240 241 243 244 245 247 248 250 251 253 254 255
+		>;
+		default-brightness-level = <162>;
+	};
+};
+
+/*
+ * Home and Volume Up: KEYOUT0 with KEYIN1/KEYIN2, the only keypad pads the
+ * bootloader muxes to the keypad. The vendor tree also lists Volume Down
+ * at row 1/column 0, but never scans column 0.
+ */
+&pwm {
+	status = "okay";
+};
+
+/*
+ * Camera sensors: rear S5K4ECGX @ 0x56 on D-PHY A, front SR200PC20M @ 0x20
+ * on D-PHY C. Only the rear needs the external 1.2 V DVDD (GPIO 193); the
+ * vendor also pulses it for the front, which works without. Rotations
+ * relative to the portrait panel, from test shots: the scene's top lands
+ * on the left of the rear image and on the right of the front image.
+ */
+&i2c0 {
+	/* the stock HAL switches the bus to 400 kHz for both sensors */
+	clock-frequency = <400000>;
+	status = "okay";
+
+	camera@20 {
+		compatible = "siliconfile,sr200pc20m";
+		reg = <0x20>;
+		clocks = <&dcam>;
+		avdd-supply = <&vddcama>;
+		dovdd-supply = <&vddcamio>;
+		reset-gpios = <&gpio 238 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&gpio 187 GPIO_ACTIVE_LOW>;
+		orientation = <0>;
+		rotation = <90>;
+
+		port {
+			front_camera_out: endpoint {
+				remote-endpoint = <&dcam_front_in>;
+				data-lanes = <1>;
+			};
+		};
+	};
+
+	camera@56 {
+		compatible = "samsung,s5k4ecgx";
+		reg = <0x56>;
+		clocks = <&dcam>;
+		avdd-supply = <&vddcama>;
+		dovdd-supply = <&vddcamio>;
+		dvdd-supply = <&cam_dvdd>;
+		afvdd-supply = <&vddcammot>;
+		reset-gpios = <&gpio 186 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&gpio 188 GPIO_ACTIVE_LOW>;
+		orientation = <1>;
+		rotation = <270>;
+
+		port {
+			rear_camera_out: endpoint {
+				remote-endpoint = <&dcam_rear_in>;
+				data-lanes = <1 2>;
+			};
+		};
+	};
+};
+
+&dcam {
+	status = "okay";
+};
+
+&dcam_phy_a {
+	dcam_rear_in: endpoint {
+		remote-endpoint = <&rear_camera_out>;
+		data-lanes = <1 2>;
+	};
+};
+
+&dcam_phy_c {
+	dcam_front_in: endpoint {
+		remote-endpoint = <&front_camera_out>;
+		data-lanes = <1>;
+	};
+};
+
+/*
+ * Accelerometer, ST LIS2HH12 (Samsung calls it K2HH): X = Y_chip,
+ * Y = -X_chip, Z = -Z_chip, found by turning the tablet under
+ * iio-sensor-proxy. The vendor's axis map (X = -Y_chip, Y = X_chip) is
+ * this turned by 180 degrees, and X = -Y_chip, Y = -X_chip got only
+ * portrait right. The data-ready line (GPIO 164) is left out, user space
+ * polls.
+ */
+&i2c2 {
+	status = "okay";
+
+	accelerometer@1d {
+		compatible = "st,lis2hh12";
+		reg = <0x1d>;
+		mount-matrix = "0", "1", "0",
+			       "-1", "0", "0",
+			       "0", "0", "-1";
+	};
+};
+
+&sdio0 {
+	bus-width = <4>;
+	cd-gpios = <&gpio 71 GPIO_ACTIVE_LOW>;	/* external pull-up */
+	cd-debounce-delay-ms = <200>;
+	disable-wp;
+	cap-sd-highspeed;
+	max-frequency = <50000000>;		/* 384 MHz / 8 = 48 MHz */
+	no-1-8-v;				/* card VDD is the pad supply */
+	sdhci-caps-mask = <0x0 0x05000000>;	/* vendor: 3.0 V only */
+	vmmc-supply = <&vddsdcore>;
+	status = "okay";
+};
+
+/*
+ * BCM43430A1 Bluetooth. Wake lines (BT_WAKE GPIO 45, HOST_WAKE GPIO 46)
+ * come later: without a host wake IRQ hci_bcm never lets the chip sleep.
+ */
+&uart0 {
+	status = "okay";
+
+	/*
+	 * BT_WAKE on GPIO 45, HOST_WAKE on GPIO 46 (vendor bcm-bt-lpm). hci_bcm
+	 * tells the controller BT_WAKE is active high and derives HOST_WAKE's
+	 * polarity from the interrupt type; the vendor ran both active low.
+	 */
+	bluetooth {
+		compatible = "brcm,bcm43430a1-bt";
+		shutdown-gpios = <&gpio 47 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&gpio 45 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&gpio 46 IRQ_TYPE_EDGE_FALLING>;
+		interrupt-names = "host-wakeup";
+		clocks = <&clk_aux0>;
+		clock-names = "lpo";
+		max-speed = <2000000>;
+	};
+};
+
+/* BCM47520 GPS, 921600 baud set by glgps (gps.xml) */
+&uart3 {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
+
+/*
+ * Mono internal speaker on the SC2723's AOL output and internal PA, fed
+ * by the VBC through the AP DMA. Headphones and capture to come.
+ */
+&ap_dma {
+	status = "okay";
+};
+
+&vbc {
+	status = "okay";
+};
+
+&audio_pcm {
+	status = "okay";
+};
+
+&sc2723_codec {
+	status = "okay";
+};
+
+/*
+ * Takes over the DSI video-mode pipeline the bootloader leaves running and
+ * sends simpledrm away; the backlight follows the CRTC as with simpledrm.
+ * Panel size from the vendor device tree.
+ */
+&dispc {
+	backlight = <&backlight>;
+	/*
+	 * NT51017 supplies (lcd_3v3_en, cabc_01_en, cabc_02_en), switched on
+	 * in this order and off in reverse, as the vendor gen-panel does
+	 */
+	panel-power-gpios = <&gpio 152 GPIO_ACTIVE_HIGH>,
+			    <&gpio 232 GPIO_ACTIVE_HIGH>,
+			    <&gpio 233 GPIO_ACTIVE_HIGH>;
+	width-mm = <129>;
+	height-mm = <206>;
+	status = "okay";
+};
+
+&keypad {
+	keypad,num-rows = <1>;
+	keypad,num-columns = <3>;
+	linux,keymap = <MATRIX_KEY(0, 1, KEY_HOMEPAGE)
+			MATRIX_KEY(0, 2, KEY_VOLUMEUP)>;
+	/* Home wakes the tablet like on Android; Volume Up comes along */
+	wakeup-source;
+	status = "okay";
+};
+
+&usb {
+	status = "okay";
+};
+
+&sdio1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	bus-width = <4>;
+	max-frequency = <50000000>;
+	cap-sd-highspeed;
+	no-1-8-v;		/* the 1.8 V switch fails like on the eMMC host */
+	no-sd;
+	no-mmc;
+	non-removable;
+	keep-power-in-suspend;
+	mmc-pwrseq = <&wifi_pwrseq>;
+	status = "okay";
+
+	/* out-of-band host wake on GPIO 148, level high as in the vendor tree */
+	wifi@1 {
+		compatible = "brcm,bcm43430a1-fmac", "brcm,bcm4329-fmac";
+		reg = <1>;
+		interrupts-extended = <&gpio 148 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "host-wake";
+	};
+};
+
+/*
+ * DDR52 with the vendor's delay-line values. The eMMC I/O rail is a fixed
+ * 1.8 V (no vqmmc supply in the vendor tree), but the 1.8 V signalling bit
+ * of this SDHCI never sticks ("1.8V regulator output did not become
+ * stable"), so ask for DDR at the 3.3 V setting directly: same result
+ * without the failed switch, and no-1-8-v also keeps HS200 off.
+ */
+&emmc {
+	bus-width = <8>;
+	non-removable;
+	no-sd;
+	no-sdio;
+	no-1-8-v;
+	cap-mmc-highspeed;
+	mmc-ddr-3_3v;
+	max-frequency = <52000000>;
+	sprd,write-delay = <0x08>;
+	sprd,read-pos-delay = <0x04>;
+	sprd,read-neg-delay = <0x04>;
+	status = "okay";
+};
+
+&vsp {
+	status = "okay";
+};
diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-j1mini.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-j1mini.dts
new file mode 100644
index 000000000..e1a0206f8
--- /dev/null
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-j1mini.dts
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy J1 mini 3G (SM-J105H / SM-J105F, "j1mini3g")
+ *
+ * SoC: Spreadtrum SC8830A / SC7731 (4x Cortex-A7, Mali-400 MP2, PMIC SC2723)
+ * RAM: 768 MiB (SM-J105H rev00-02) / 1024 MiB (rev03 / SM-J105F)
+ * Display: 4.0" 480x800 WVGA MIPI DSI video mode (Samsung S6D77A1 or Himax HX8369B)
+ * Touchscreen: FocalTech FT6206 (I2C1 @ 0x38, IRQ GPIO 232)
+ * Accelerometer: Bosch BMA250E (I2C2 @ 0x18, IRQ GPIO 238)
+ * Storage: eMMC (sdio1), microSD (sdio0)
+ * Modem: Spreadtrum SC8830 3G baseband with SIPC
+ *
+ * Inherits the SC7730/SC8830 mainline support from gtelwifi-mainline.
+ */
+
+/dts-v1/;
+
+#include "sc7730.dtsi"
+#include "sc7730-modem.dtsi"
+
+/ {
+	model = "Samsung Galaxy J1 mini (SM-J105H/F, j1mini3g)";
+	compatible = "samsung,j1mini3g", "samsung,j1mini", "sprd,sc8830", "sprd,sc7730";
+
+	/*
+	 * Board IDs matched by Spreadtrum bootloader against dt.img QCDT.
+	 * Revisions 0-3 cover all known J1 mini hardware board revisions.
+	 */
+	sprd,sc-id = <8830 0 0x20000>,
+		     <8830 1 0x20000>,
+		     <8830 2 0x20000>,
+		     <8830 3 0x20000>;
+
+	aliases {
+		serial1 = &uart1;
+		mmc0 = &emmc;
+		mmc1 = &sdio0;
+		mmc2 = &sdio1;
+	};
+
+	chosen {
+		bootargs = "";
+	};
+
+	/*
+	 * RAM: 768 MiB default (rev 00-02), bootloader can update size.
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x30000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* Shared memory between AP and CP (modem) */
+		smem@87800000 {
+			reg = <0x87800000 0x200000>;
+			no-map;
+		};
+
+		/* 28 MiB CP modem memory as defined in vendor J1 mini DT */
+		cp-modem@88000000 {
+			reg = <0x88000000 0x1c00000>;
+			no-map;
+		};
+
+		/* WCN modem carveout (2M+4K) */
+		cp-wcn@8a800000 {
+			reg = <0x8a800000 0x201000>;
+			no-map;
+		};
+
+		/*
+		 * Kernel crash log survives warm reboot in RAM.
+		 * Placed at 0x8fe00000 (1 MiB), safely inside unused RAM.
+		 */
+		ramoops@8fe00000 {
+			compatible = "ramoops";
+			reg = <0x8fe00000 0x100000>;
+			record-size = <0x40000>;
+			console-size = <0x40000>;
+			pmsg-size = <0x20000>;
+		};
+
+		/* Samsung bootloader sec_log region (preserves log for last_kmsg) */
+		sec_log@86b00000 {
+			reg = <0x86b00000 0x100000>;
+			no-map;
+		};
+
+		/*
+		 * Vendor bootloader framebuffer scan-out buffer:
+		 * 480 * 800 * 4 = 0x177000 bytes at 0x9F197000 (confirmed by sboot log).
+		 */
+		framebuffer@9f197000 {
+			reg = <0x9f197000 0x180000>;
+			no-map;
+		};
+
+		/*
+		 * Scan-out and GPU DMA buffers for DISPC.
+		 * 32 MiB CMA pool sized for 768 MiB total RAM.
+		 */
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x2000000>;
+			alloc-ranges = <0x90000000 0x8000000>;
+			linux,cma-default;
+		};
+	};
+
+	/*
+	 * Fallback scan-out buffer left scanning out by sboot.
+	 * 480x800, 32bpp (ARGB/XRGB), stride 1920 (480*4).
+	 */
+	framebuffer: framebuffer@9f197000 {
+		compatible = "simple-framebuffer";
+		reg = <0x9f197000 (480 * 800 * 4)>;
+		width = <480>;
+		height = <800>;
+		stride = <(480 * 4)>;
+		format = "x8r8g8b8";
+	};
+};
+
+/*
+ * DISPC takeover disabled for initial bringup: simpledrm owns the bootloader
+ * framebuffer cleanly and keeps fbcon console active through to userspace.
+ */
+&dispc {
+	status = "disabled";
+};
+
+&gpu {
+	status = "disabled";
+};
+
+/* eMMC internal storage (sdio@20600000) */
+&emmc {
+	bus-width = <8>;
+	non-removable;
+	no-sd;
+	no-sdio;
+	no-1-8-v;
+	cap-mmc-highspeed;
+	mmc-ddr-3_3v;
+	max-frequency = <52000000>;
+	sprd,write-delay = <0x1b>;
+	sprd,read-pos-delay = <0x0c>;
+	sprd,read-neg-delay = <0x0c>;
+	status = "okay";
+};
+
+/* MicroSD slot (sdio@20300000) */
+&sdio0 {
+	status = "okay";
+};
+
+/* WLAN SDIO slot (sdio@20400000) */
+&sdio1 {
+	status = "okay";
+};
+
+/* USB OTG / Device mode controller (dwc2) */
+&usb {
+	dr_mode = "peripheral";
+	role-switch-default-mode = "peripheral";
+	g-np-tx-fifo-size = <0x40>;
+	status = "okay";
+};
+
+/*
+ * I2C1: Touchscreen controller
+ * Hardware: MELFAS MCS8040L (mip4_ts) @ 0x48
+ */
+&i2c1 {
+	status = "okay";
+
+	touchscreen@48 {
+		compatible = "melfas,mip4_ts";
+		reg = <0x48>;
+		interrupt-parent = <&gpio>;
+		interrupts = <232 IRQ_TYPE_EDGE_FALLING>;
+		touchscreen-size-x = <480>;
+		touchscreen-size-y = <800>;
+	};
+};
+
+/*
+ * I2C2: Sensors
+ * Accelerometer Bosch BMA250E (bma2x2)
+ */
+&i2c2 {
+	status = "okay";
+
+	accelerometer@18 {
+		compatible = "bosch,bma250e", "bosch,bma222e";
+		reg = <0x18>;
+		interrupt-parent = <&gpio>;
+		interrupts = <238 IRQ_TYPE_EDGE_RISING>;
+	};
+};
+
+/*
+ * Hardware Keypad (Volume Up, Volume Down, Home)
+ */
+&keypad {
+	keypad,num-rows = <1>;
+	keypad,num-columns = <3>;
+	status = "okay";
+};
+
+/* Modem IPC channels */
+&sipc {
+	status = "okay";
+};
+
+&scproc_cpw {
+	status = "okay";
+	reg = <0x88000000 0x1c00000>,
+	      <0x50000000 0xc>,
+	      <0x402b0000 0x10000>;
+
+	modem {
+		reg = <0x88300000 0xc00000>;
+	};
+};
+
+/ {
+	spipe-cpw { status = "okay"; };
+	slog-cpw { status = "okay"; };
+	stty-cpw { status = "okay"; };
+	seth0-cpw { status = "okay"; };
+	seth1-cpw { status = "okay"; };
+	seth2-cpw { status = "okay"; };
+};
+
+/*
+ * Disable cpufreq OPP table for now: SC8830 clock scaling & regulator
+ * differ from SC7730SE and cause schedutil to spam transition errors.
+ */
+&cpu0 { /delete-property/ operating-points-v2; };
+&cpu1 { /delete-property/ operating-points-v2; };
+&cpu2 { /delete-property/ operating-points-v2; };
+&cpu3 { /delete-property/ operating-points-v2; };
+/delete-node/ &cpu_opp;
+
diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
new file mode 100644
index 000000000..14276a3e2
--- /dev/null
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -0,0 +1,698 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Spreadtrum SC7730 ("scx35", "shark") SoC, 4x Cortex-A7, Mali-400 MP2.
+ *
+ * Addresses are physical and come from the vendor 3.10 kernel
+ * (arch/arm/mach-sc/include/mach/__hardware-sc8830.h). The vendor
+ * device tree uses static virtual mappings (0xf5xxxxxx), translated here.
+ *
+ * Only what is needed for a first mainline boot is described: one CPU,
+ * GIC, timer, UART. Everything else is still set up by the bootloader.
+ */
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/thermal/thermal.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	interrupt-parent = <&intc>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		/* boot ROM pen + PMU power domains, mach-sprd/platsmp.c */
+		enable-method = "sprd,sc7730-smp";
+
+		cpu0: cpu@f00 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0xf00>;
+			clock-frequency = <1300000000>;
+			clocks = <&cpu_clk>;
+			operating-points-v2 = <&cpu_opp>;
+			cpu-supply = <&vddarm>;
+			#cooling-cells = <2>;
+		};
+
+		cpu1: cpu@f01 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0xf01>;
+			clock-frequency = <1300000000>;
+			clocks = <&cpu_clk>;
+			operating-points-v2 = <&cpu_opp>;
+			cpu-supply = <&vddarm>;
+			#cooling-cells = <2>;
+		};
+
+		cpu2: cpu@f02 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0xf02>;
+			clock-frequency = <1300000000>;
+			clocks = <&cpu_clk>;
+			operating-points-v2 = <&cpu_opp>;
+			cpu-supply = <&vddarm>;
+			#cooling-cells = <2>;
+		};
+
+		cpu3: cpu@f03 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0xf03>;
+			clock-frequency = <1300000000>;
+			clocks = <&cpu_clk>;
+			operating-points-v2 = <&cpu_opp>;
+			cpu-supply = <&vddarm>;
+			#cooling-cells = <2>;
+		};
+	};
+
+	/*
+	 * Vendor table (cpufreq-scx35.c, chip ID 0x8730Cxxx): voltages are
+	 * nominal, sboot trims the rail by about -10 mV only until the first
+	 * write. 768 MHz runs from TDPLL, the others from MPLL.
+	 */
+	cpu_opp: opp-table-cpu {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-768000000 {
+			opp-hz = /bits/ 64 <768000000>;
+			opp-microvolt = <900000>;
+			clock-latency-ns = <300000>;
+			opp-suspend;
+		};
+
+		opp-1000000000 {
+			opp-hz = /bits/ 64 <1000000000>;
+			opp-microvolt = <900000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <1000000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-1300000000 {
+			opp-hz = /bits/ 64 <1300000000>;
+			opp-microvolt = <1050000>;
+			clock-latency-ns = <300000>;
+		};
+
+		/*
+		 * Overclocking, beyond the vendor table: MPLL in 52 MHz steps,
+		 * +25 mV each, AXI at core/4 above 1.5 GHz. Checked on one unit
+		 * (four-core sha256 load, 3 min at 1612 MHz, 74 C). Not plain
+		 * "turbo-mode": schedutil would never pick those, so user space
+		 * caps scaling_max_freq at 1300 MHz unless asked otherwise.
+		 */
+		opp-1352000000 {
+			opp-hz = /bits/ 64 <1352000000>;
+			opp-microvolt = <1075000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-1404000000 {
+			opp-hz = /bits/ 64 <1404000000>;
+			opp-microvolt = <1100000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-1456000000 {
+			opp-hz = /bits/ 64 <1456000000>;
+			opp-microvolt = <1125000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-1508000000 {
+			opp-hz = /bits/ 64 <1508000000>;
+			opp-microvolt = <1150000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-1560000000 {
+			opp-hz = /bits/ 64 <1560000000>;
+			opp-microvolt = <1175000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-1612000000 {
+			opp-hz = /bits/ 64 <1612000000>;
+			opp-microvolt = <1200000>;
+			clock-latency-ns = <300000>;
+		};
+	};
+
+	/* SC2723 DCDC_ARM, the Cortex-A7 cluster supply (mach-sprd/sc2723-dcdc-arm.c) */
+	vddarm: regulator-vddarm {
+		compatible = "sprd,sc2723-dcdc-arm";
+		regulator-name = "vddarm";
+		regulator-min-microvolt = <900000>;
+		regulator-max-microvolt = <1200000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/*
+	 * SC2723 companion PMIC behind the ADI bus, as a regmap with its
+	 * interrupt controller (mach-sprd/sc2723-pmic.c) until spi-sprd-adi
+	 * and the sc27xx MFD know it. Children use the mainline drivers.
+	 */
+	pmic: pmic {
+		compatible = "sprd,sc2723-adi-pmic";
+		interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rtc@80 {
+			compatible = "sprd,sc2731-rtc";
+			reg = <0x80>;
+			interrupt-parent = <&pmic>;
+			interrupts = <2 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		/* analog audio codec, mono speaker path (sound/soc/codecs/sc2723-codec.c) */
+		sc2723_codec: audio-codec@600 {
+			compatible = "sprd,sc2723-codec";
+			reg = <0x600>;
+			#sound-dai-cells = <0>;
+			status = "disabled";
+		};
+
+		pmic_eic: gpio@100 {
+			compatible = "sprd,sc2731-eic";
+			reg = <0x100>;
+			interrupt-parent = <&pmic>;
+			interrupts = <5 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
+
+	/*
+	 * Spreadtrum PCM platform: one AP DMA channel per audio channel, fed
+	 * by the VBC FIFO requests (UID 29/30 = DA0/DA1).
+	 */
+	audio_pcm: audio-platform {
+		compatible = "sprd,pcm-platform";
+		dmas = <&ap_dma 29>, <&ap_dma 30>, <&ap_dma 31>, <&ap_dma 32>;
+		dma-names = "normal_p_l", "normal_p_r", "normal_c_l", "normal_c_r";
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	/* SC2723 auxiliary ADC (mach-sprd/sc2723-adc.c), raw counts */
+	pmic_adc: adc {
+		compatible = "sprd,sc2723-adc-polled";
+		#io-channel-cells = <1>;
+	};
+
+	/*
+	 * Counts the CoreSight timestamp generator TS1 at 26 MHz, which
+	 * mach-sprd/sc7730.c starts (and sets CNTFRQ for). The kernel runs in
+	 * the Secure world with a random CNTVOFF: secure physical timer, and
+	 * no virtual counter for user space.
+	 */
+	timer {
+		compatible = "arm,armv7-timer";
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
+		arm,cpu-registers-not-fw-configured;
+	};
+
+	/*
+	 * The vendor defined passive trips at 80, 88 and 100 C but never
+	 * registered a cooling device for them; here cpufreq throttles from
+	 * 85 C, with a hot notification at 100 C and the vendor's critical
+	 * shutdown at 110 C.
+	 */
+	thermal-zones {
+		cpu-thermal {
+			polling-delay-passive = <500>;
+			polling-delay = <2000>;
+			thermal-sensors = <&ap_thm>;
+
+			trips {
+				cpu_alert: cpu-alert {
+					temperature = <85000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				cpu-hot {
+					temperature = <100000>;
+					hysteresis = <5000>;
+					type = "hot";
+				};
+
+				cpu-critical {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu_alert>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT
+							  THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+	};
+
+	ext_32k: clock-32k {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+		clock-output-names = "ext-32k";
+	};
+
+	ext_26m: clock-26m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <26000000>;
+		clock-output-names = "ext-26m";
+	};
+
+	/*
+	 * Mali core clock: mach-sprd/pm-domains.c selects 384 MHz (TDPLL / 2)
+	 * in the GPU's own clock mux on every power-up of the GPU domain.
+	 */
+	gpu_clk: clock-gpu {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <384000000>;
+		clock-output-names = "gpu";
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* GPU_TOP and MM_TOP power domains (mach-sprd/pm-domains.c) */
+		pmu_domains: power-controller@402b0000 {
+			compatible = "sprd,sc7730-pmu-domains";
+			reg = <0x402b0000 0x100>, <0x402e0000 0x4>;
+			reg-names = "pmu", "aon-apb";
+			#power-domain-cells = <1>;
+		};
+
+		/*
+		 * On-die temperature sensor, gated off after the bootloader;
+		 * gate, RTC clock and reset in AON APB. Polled (SPI 26 unused).
+		 */
+		ap_thm: thermal-sensor@402f0000 {
+			compatible = "sprd,sc7730-thermal";
+			reg = <0x402f0000 0x1000>, <0x402e0000 0x4000>;
+			reg-names = "thm", "aon-apb";
+			#thermal-sensor-cells = <0>;
+		};
+
+		/*
+		 * Cortex-A7 cluster clock: CA7_CKG_CFG in AP AHB and MPLL_CFG1
+		 * in AON APB (mach-sprd/clk-cpu.c)
+		 */
+		cpu_clk: clock-controller@20d03000 {
+			compatible = "sprd,sc7730-cpu-clk";
+			reg = <0x20d03000 0x4>, <0x402e3070 0x4>;
+			reg-names = "ckg", "mpll";
+			#clock-cells = <0>;
+		};
+
+		/* AP AHB enable bits as gate clocks (mach-sprd/clk-gates.c) */
+		ap_ahb_gates: clock-controller@20d00000 {
+			compatible = "sprd,sc7730-gates";
+			reg = <0x20d00000 0x4>;
+			clocks = <&ext_26m>;
+			#clock-cells = <1>;
+		};
+
+		/*
+		 * AP DMA (r4p0, the SC9860 layout), gate AP_AHB bit 5, off after
+		 * the bootloader. Only channels 24-31 are "full" channels. Audio
+		 * request IDs: VB_DA0/1 = 29/30, VB_AD0-3 = 31-34.
+		 */
+		ap_dma: dma-controller@20100000 {
+			compatible = "sprd,sc7730-dma";
+			reg = <0x20100000 0x4000>;
+			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ap_ahb_gates 5>;
+			clock-names = "enable";
+			#dma-cells = <1>;
+			dma-channels = <32>;
+			status = "disabled";
+		};
+
+		/*
+		 * Voice band codec FIFOs and the digital DAC part ("DP") of the
+		 * audio codec; clocks, resets and the hand-over from the modem
+		 * side in AON APB (sound/soc/sprd/sprd-vbc-sc7730.c).
+		 */
+		vbc: audio-controller@40020000 {
+			compatible = "sprd,sc7730-vbc";
+			reg = <0x40020000 0x1000>, <0x40000000 0x1000>,
+			      <0x402e0000 0x4000>;
+			reg-names = "vbc", "dp", "aon-apb";
+			#sound-dai-cells = <0>;
+			status = "disabled";
+		};
+
+		/*
+		 * Display controller. Its clocks and gates (AP_AHB EB bit 1,
+		 * AON_APB EB1 bit 11, AP_APB EB bit 18, AP_CLK 0x2c-0x34) are
+		 * set up by the bootloader and only read by the driver.
+		 */
+		dispc: display-controller@20800000 {
+			compatible = "sprd,sc7730-dispc";
+			reg = <0x20800000 0x1000>, <0x20d00000 0x4>,
+			      <0x402e0000 0x8>, <0x71300000 0x4>,
+			      <0x71200000 0x40>, <0x21800000 0x1000>;
+			reg-names = "dispc", "ap-ahb", "aon-apb", "ap-apb",
+				    "ap-clk", "dsi";
+			interrupts = <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>;
+			status = "disabled";
+		};
+
+		/*
+		 * Mali-400 MP2, all units on one interrupt line. Its AXI enable
+		 * (AON_APB EB0 bit 27) is switched with the power domain.
+		 */
+		gpu: gpu@60000000 {
+			compatible = "sprd,sc7730-mali", "arm,mali-400";
+			reg = <0x60000000 0x10000>;
+			interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "gp", "gpmmu", "pp0", "ppmmu0",
+					  "pp1", "ppmmu1";
+			clocks = <&gpu_clk>, <&gpu_clk>;
+			clock-names = "bus", "core";
+			power-domains = <&pmu_domains 0>;
+			status = "disabled";
+		};
+
+		mm_ahb: syscon@60d00000 {
+			compatible = "sprd,sc7730-mm-ahb", "syscon";
+			reg = <0x60d00000 0x100>;
+		};
+
+		vsp: video-codec@60900000 {
+			compatible = "sprd,sc7730-vsp";
+			reg = <0x60900000 0xc000>, <0x60e00000 0x100>,
+			      <0x402e0000 0x100>;
+			reg-names = "vsp", "mm-clk", "aon-apb";
+			sprd,mm-ahb = <&mm_ahb>;
+			interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&pmu_domains 1>;
+			status = "disabled";
+		};
+
+		/*
+		 * Camera: DCAM capture engine and the CSI-2 host (DesignWare
+		 * 1.03). Port 0 is D-PHY A (2 lanes), port 1 D-PHY C (1 lane).
+		 * MM AHB, MM clocks and AON_APB are shared registers; the block
+		 * also provides the sensor master clock (24 MHz).
+		 */
+		dcam: camera@60800000 {
+			compatible = "sprd,sc7730-dcam";
+			reg = <0x60800000 0x2000>, <0x60c00000 0x1000>,
+			      <0x60e00000 0x100>,
+			      <0x402e0000 0x100>;
+			reg-names = "dcam", "csi", "mm-clk", "aon-apb";
+			sprd,mm-ahb = <&mm_ahb>;
+			interrupts = <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&pmu_domains 1>;
+			#clock-cells = <0>;
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				dcam_phy_a: port@0 {
+					reg = <0>;
+				};
+
+				dcam_phy_c: port@1 {
+					reg = <1>;
+				};
+			};
+		};
+
+		gic: interrupt-controller@12001000 {
+			compatible = "arm,cortex-a7-gic";
+			#interrupt-cells = <3>;
+			interrupt-controller;
+			interrupt-parent = <&gic>;
+			reg = <0x12001000 0x1000>,
+			      <0x12002000 0x2000>;
+		};
+
+		/*
+		 * Wake-up gates in front of the GIC: an idle CPU only wakes
+		 * for interrupts enabled here. All SPIs go through it.
+		 */
+		intc: interrupt-controller@71400000 {
+			compatible = "sprd,sc8830-intc";
+			#interrupt-cells = <3>;
+			interrupt-controller;
+			interrupt-parent = <&gic>;
+			reg = <0x71400000 0x1000>, <0x71500000 0x1000>,
+			      <0x71600000 0x1000>, <0x71700000 0x1000>,
+			      <0x71300000 0x4>;		/* AP APB clock gates */
+		};
+
+		timer@40050000 {
+			compatible = "sprd,sc8830-timer";
+			reg = <0x40050000 0x60>,	/* AON timer block */
+			      <0x402e0000 0x10>;	/* AON APB clock gates */
+			reg-names = "timer", "aon-apb";
+			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
+			clock-frequency = <32768>;
+		};
+
+		/*
+		 * Synopsys DWC OTG ("sprd,usb" in the vendor tree). PHY power,
+		 * clock and resets are still done by mach-sprd/usb-bringup.c.
+		 * No VBUS sensing wired to the core: the role switch override
+		 * forces the B-session valid, like the vendor driver does.
+		 *
+		 * FIFOs (32-bit words) as in the vendor dwc_otg for SCX35, only
+		 * TX FIFO 15 trimmed so everything fits the 3598-word SPRAM.
+		 * TX FIFOs 1 and 2 are only 0x40 deep, too small for HS bulk;
+		 * the dwc2 defaults left no FIFO for a 512-byte bulk IN endpoint.
+		 */
+		usb: usb@20200000 {
+			compatible = "snps,dwc2";
+			reg = <0x20200000 0x40000>;
+			interrupts = <GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ap_ahb_gates 4>;
+			clock-names = "otg";
+			dr_mode = "peripheral";
+			usb-role-switch;
+			role-switch-default-mode = "peripheral";
+			g-rx-fifo-size = <0x320>;
+			g-np-tx-fifo-size = <0x40>;
+			g-tx-fifo-size = <0x40 0x40 0x100 0x100 0x100 0x100 0x100
+					  0x80 0x80 0x80 0x80 0x80 0x80 0x80 0x100>;
+			status = "disabled";
+		};
+
+		/*
+		 * eMMC host (vendor: sdhci@f511c000, "sprd,sdhci-shark", id 3).
+		 * Base clock: AP_CLK_EMMC_CFG mux, 26/256/312/384 MHz. Gate
+		 * (AP_AHB_EB bit 11), pinmux and card power come from the
+		 * bootloader for now.
+		 */
+		emmc: mmc@20600000 {
+			compatible = "sprd,sc7730-sdhci";
+			reg = <0x20600000 0x1000>, <0x71200054 0x4>;
+			reg-names = "sdhci", "clk-cfg";
+			interrupts = <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>;
+			sprd,clk-parent-rates = <26000000 256000000 312000000 384000000>;
+			status = "disabled";
+		};
+
+		/*
+		 * SDIO1, the WLAN slot. Unlike the eMMC host it is left gated by
+		 * the bootloader: AP_AHB EB bit 9, soft reset bit 12. Base clock
+		 * mux AP_CLK_SDIO1_CFG (48/76.8/96/128 MHz, bootloader: 48).
+		 */
+		sdio1: mmc@20400000 {
+			compatible = "sprd,sc7730-sdhci";
+			reg = <0x20400000 0x1000>, <0x7120004c 0x4>,
+			      <0x20d00000 0x8>;
+			reg-names = "sdhci", "clk-cfg", "ap-ahb";
+			interrupts = <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ap_ahb_gates 9>;
+			clock-names = "ahb";
+			sprd,clk-parent-rates = <48000000 76800000 96000000 128000000>;
+			sprd,ahb-eb-bit = <9>;
+			sprd,ahb-rst-bit = <12>;
+			status = "disabled";
+		};
+
+		/*
+		 * SDIO0, the microSD slot (vendor id 0). Gated by the
+		 * bootloader: AP_AHB EB bit 8, soft reset bit 11. Base clock
+		 * AP_CLK_SDIO0_CFG: mux bits 1:0, divider bits 10:8.
+		 */
+		sdio0: mmc@20300000 {
+			compatible = "sprd,sc7730-sdhci";
+			reg = <0x20300000 0x1000>, <0x71200048 0x4>,
+			      <0x20d00000 0x8>;
+			reg-names = "sdhci", "clk-cfg", "ap-ahb";
+			interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ap_ahb_gates 8>;
+			clock-names = "ahb";
+			sprd,clk-parent-rates = <26000000 256000000 312000000 384000000>;
+			sprd,clk-sel = <3>;	/* 384 MHz like the vendor */
+			sprd,clk-has-div;
+			sprd,ahb-eb-bit = <8>;
+			sprd,ahb-rst-bit = <11>;
+			status = "disabled";
+		};
+
+		/* AP APB enable bits as gate clocks (mach-sprd/clk-gates.c) */
+		ap_apb_gates: clock-controller@71300000 {
+			compatible = "sprd,sc7730-gates";
+			reg = <0x71300000 0x4>;
+			clocks = <&ext_26m>;
+			#clock-cells = <1>;
+		};
+
+		/* CLK_AUX0 pad, 32 kHz (mach-sprd/clk-aux0.c) */
+		clk_aux0: clock-controller@402e0000 {
+			compatible = "sprd,sc7730-aux0-clk";
+			reg = <0x402e0000 0x4000>;
+			clocks = <&ext_32k>;
+			#clock-cells = <0>;
+		};
+
+		/* Same register layout as the SC9860 "d-gpio" block */
+		gpio: gpio@40280000 {
+			compatible = "sprd,sc9860-gpio";
+			reg = <0x40280000 0x1000>;
+			interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		/* I2C0, the camera sensors. Gate and reset: bit 8 in AP_APB. */
+		i2c0: i2c@70500000 {
+			compatible = "sprd,sc8830-i2c";
+			reg = <0x70500000 0x1000>, <0x71300000 0x8>;
+			reg-names = "i2c", "ap-apb";
+			sprd,ap-apb-bit = <8>;
+			clocks = <&ext_26m>;
+			clock-frequency = <100000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		/*
+		 * I2C1. Source clock 26 MHz (AP_CLK_I2C1_CFG mux 0, as the
+		 * vendor leaves it); gate and reset are bit 9 in AP_APB.
+		 */
+		i2c1: i2c@70600000 {
+			compatible = "sprd,sc8830-i2c";
+			reg = <0x70600000 0x1000>, <0x71300000 0x8>;
+			reg-names = "i2c", "ap-apb";
+			sprd,ap-apb-bit = <9>;
+			clocks = <&ext_26m>;
+			clock-frequency = <100000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		/* I2C2, sensors on the gtelwifi. Gate and reset: bit 10. */
+		i2c2: i2c@70700000 {
+			compatible = "sprd,sc8830-i2c";
+			reg = <0x70700000 0x1000>, <0x71300000 0x8>;
+			reg-names = "i2c", "ap-apb";
+			sprd,ap-apb-bit = <10>;
+			clocks = <&ext_26m>;
+			clock-frequency = <100000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		/*
+		 * Keypad matrix (vendor: sprd,sci-keypad). Clock gates (AON_APB
+		 * EB0 bit 8, RTC_EB bit 1) and soft reset (RST0 bit 8) are set
+		 * up by the driver through "aon-apb".
+		 */
+		keypad: keypad@40250000 {
+			compatible = "sprd,sc8830-keypad";
+			reg = <0x40250000 0x1000>, <0x402e0000 0x14>;
+			reg-names = "kpd", "aon-apb";
+			interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>;
+			status = "disabled";
+		};
+
+		/*
+		 * Always-on PWM, four channels. Gates are AON APB EB0 bits
+		 * 4..7, clock selects one register per channel at 0x402d0038.
+		 */
+		pwm: pwm@40260000 {
+			compatible = "sprd,sc8830-pwm";
+			reg = <0x40260000 0x80>, <0x402e0000 0x4>,
+			      <0x402d0038 0x10>;
+			reg-names = "pwm", "aon-apb", "clk-sel";
+			clocks = <&ext_26m>;
+			#pwm-cells = <3>;
+			status = "disabled";
+		};
+
+		/* Bluetooth on the gtelwifi; 26 MHz (vendor: 48 MHz) */
+		uart0: serial@70000000 {
+			compatible = "sprd,sc9836-uart";
+			reg = <0x70000000 0x100>;
+			interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ap_apb_gates 13>, <&ext_26m>;
+			clock-names = "enable", "uart";
+			status = "disabled";
+		};
+
+		uart1: serial@70100000 {
+			compatible = "sprd,sc9836-uart";
+			reg = <0x70100000 0x100>;
+			interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ap_apb_gates 14>, <&ext_26m>;
+			clock-names = "enable", "uart";
+			status = "disabled";
+		};
+
+		uart3: serial@70300000 {
+			compatible = "sprd,sc9836-uart";
+			reg = <0x70300000 0x100>;
+			interrupts = <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ap_apb_gates 16>, <&ext_26m>;
+			clock-names = "enable", "uart";
+			status = "disabled";
+		};
+	};
+};
