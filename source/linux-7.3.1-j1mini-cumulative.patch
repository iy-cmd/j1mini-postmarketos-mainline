@@ -0,0 +1,33 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+comment "Spreadtrum media platform drivers"
+
+config VIDEO_SC7730_DCAM
+	tristate "Spreadtrum SC7730 camera capture (DCAM + CSI-2)"
+	depends on V4L_PLATFORM_DRIVERS
+	depends on VIDEO_DEV && OF && COMMON_CLK
+	depends on ARCH_SPRD || COMPILE_TEST
+	depends on PM
+	select MFD_SYSCON
+	select MEDIA_CONTROLLER
+	select V4L2_FWNODE
+	select VIDEO_V4L2_SUBDEV_API
+	select VIDEOBUF2_DMA_CONTIG
+	help
+	  Camera capture on the Spreadtrum SC7730/SC8830: the CSI-2 host
+	  with its D-PHYs and the DCAM capture engine, for sensors with an
+	  embedded ISP that deliver YUV.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called sc7730-dcam.
+
+config VIDEO_SC7730_VSP
+	bool "Spreadtrum SC7730 privileged VSP bridge"
+	depends on ARCH_SPRD && OF && PM
+	select DMA_SHARED_BUFFER
+	select MFD_SYSCON
+	help
+	  Register mapping, coherent buffers, clocks and interrupt waiting
+	  for the SCX35 vendor video decoder API. This raw DMA interface
+	  requires CAP_SYS_RAWIO and is intended for decoder bring-up.
+	  Only one acquisition may own the engine at a time.
