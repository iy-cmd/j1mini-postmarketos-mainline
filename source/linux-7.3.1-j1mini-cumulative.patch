diff --git a/Documentation/devicetree/bindings/sound/sprd,sc7730-vbc.yaml b/Documentation/devicetree/bindings/sound/sprd,sc7730-vbc.yaml
new file mode 100644
index 000000000..bf695ab21
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/sprd,sc7730-vbc.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/sprd,sc7730-vbc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC7730 voice band codec interface (VBC)
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  Audio interface of the SC7730 and the other SoCs of the SC8830 ("shark")
+  family, used as the CPU DAI. The VBC has two DA FIFOs (left and right,
+  16-bit samples, ping-pong halves of 160 frames) and four AD FIFOs, which
+  the AP DMA serves on VBC requests. It feeds the digital part of the audio
+  codec in the SoC (the "DP": DAC filters, sample rate converters and the
+  sigma-delta modulators), which talks to the analog codec in the SC2723
+  PMIC over an internal link.
+
+  Clock gates, soft reset and the hand-over of the VBC and its interrupts
+  and DMA requests from the modem side are bits in AON APB registers shared
+  with other always-on peripherals; the "aon-apb" region points there.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: sprd,sc7730-vbc
+
+  reg:
+    items:
+      - description: VBC registers (FIFOs and their control)
+      - description: Digital audio codec part (DP)
+      - description: AON APB registers
+
+  reg-names:
+    items:
+      - const: vbc
+      - const: dp
+      - const: aon-apb
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    audio-controller@40020000 {
+        compatible = "sprd,sc7730-vbc";
+        reg = <0x40020000 0x1000>, <0x40000000 0x1000>,
+              <0x402e0000 0x4000>;
+        reg-names = "vbc", "dp", "aon-apb";
+        #sound-dai-cells = <0>;
+    };
+...
diff --git a/Documentation/devicetree/bindings/thermal/sprd,sc7730-thermal.yaml b/Documentation/devicetree/bindings/thermal/sprd,sc7730-thermal.yaml
new file mode 100644
index 000000000..a327484b4
--- /dev/null
+++ b/Documentation/devicetree/bindings/thermal/sprd,sc7730-thermal.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/sprd,sc7730-thermal.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC7730 on-die temperature sensor
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  Temperature sensor of the SC7730 application processor die. Once enabled
+  it converts periodically (for example every 2.25 s); the
+  reading is linear in temperature (623 at -40 C, 1030 at 120 C) and can
+  raise interrupts at programmable thresholds. Not compatible with the
+  multi-sensor controller of the later Spreadtrum SoCs (sprd,ums512-thermal).
+
+  Its clock gate (AON APB EB1 bit 1), its RTC clock gates (RTC_EB bits 10,
+  11 and 13) and its soft reset (RST1 bit 1) are bits in AON APB registers
+  shared with other always-on peripherals; the "aon-apb" region points
+  there.
+
+allOf:
+  - $ref: thermal-sensor.yaml#
+
+properties:
+  compatible:
+    const: sprd,sc7730-thermal
+
+  reg:
+    items:
+      - description: Temperature sensor registers
+      - description: AON APB clock enable and reset registers
+
+  reg-names:
+    items:
+      - const: thm
+      - const: aon-apb
+
+  interrupts:
+    maxItems: 1
+
+  '#thermal-sensor-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - '#thermal-sensor-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    thermal-sensor@402f0000 {
+        compatible = "sprd,sc7730-thermal";
+        reg = <0x402f0000 0x1000>, <0x402e0000 0x4000>;
+        reg-names = "thm", "aon-apb";
+        #thermal-sensor-cells = <0>;
+    };
+...
diff --git a/Documentation/devicetree/bindings/timer/sprd,sc8830-timer.yaml b/Documentation/devicetree/bindings/timer/sprd,sc8830-timer.yaml
new file mode 100644
index 000000000..c1d52bd04
--- /dev/null
+++ b/Documentation/devicetree/bindings/timer/sprd,sc8830-timer.yaml
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/sprd,sc8830-timer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC8830/SC7730 general purpose timer
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  32-bit timer blocks of the SC7730 and the other SoCs of the SC8830
+  ("shark") family, one in the always-on (AON) domain and three in the AP
+  domain. Each block has three down-counting channels 0x20 apart, with
+  load, value, control, interrupt and shadow counter registers, and one
+  interrupt line. The AON block runs from the 32.768 kHz clock.
+
+  Unlike the 64-bit timers of the SC9860 (sprd,sc9860-timer) the counters
+  are 32 bits wide and the register layout differs.
+
+  The clock gates of the timers are bits in the AON APB clock enable
+  register EB0 (AON timer bit 11, AP timer 0 bit 12, system counter bit
+  10), which is shared with other AON peripherals; the optional "aon-apb"
+  region points there.
+
+properties:
+  compatible:
+    const: sprd,sc8830-timer
+
+  reg:
+    minItems: 1
+    items:
+      - description: Timer block (three channels)
+      - description: AON APB clock enable registers
+
+  reg-names:
+    minItems: 1
+    items:
+      - const: timer
+      - const: aon-apb
+
+  interrupts:
+    maxItems: 1
+
+  clock-frequency:
+    description: Rate of the timer clock in Hz.
+    default: 32768
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    timer@40050000 {
+        compatible = "sprd,sc8830-timer";
+        reg = <0x40050000 0x60>, <0x402e0000 0x10>;
+        reg-names = "timer", "aon-apb";
+        interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
+        clock-frequency = <32768>;
+    };
+...
diff --git a/arch/arm/Kconfig.platforms b/arch/arm/Kconfig.platforms
index 2e118b65f..9b8bd4693 100644
--- a/arch/arm/Kconfig.platforms
+++ b/arch/arm/Kconfig.platforms
@@ -159,6 +159,150 @@ config ARCH_RDA
 	help
 	  This enables support for the RDA Micro 8810PL SoC family.
 
+config ARCH_SPRD
+	bool "Spreadtrum/Unisoc 32-bit SoCs (SC7730/SC8830 \"shark\")"
+	depends on ARCH_MULTI_V7
+	select ARM_GIC
+	select HAVE_ARM_ARCH_TIMER
+	select SPRD_SC8830_INTC
+	select SPRD_SC8830_TIMER
+	help
+	  Support for the 32-bit Spreadtrum SC7730/SC8830 ("scx35"/"shark")
+	  family, e.g. the Samsung Galaxy Tab E 9.6 (SM-T560, gtelwifi).
+
+config SPRD_BOOTSTRIPES
+	bool "Paint boot progress stripes into the bootloader framebuffer"
+	depends on ARCH_SPRD
+	help
+	  Debug aid for bring-up without a serial console. The Spreadtrum
+	  bootloader passes the scan-out buffer of its splash screen as
+	  "lcd_base=<hex>" on the command line. With this option the kernel
+	  reserves that buffer and paints a white band for every boot stage
+	  it reaches, so a photo of the screen shows where boot stopped.
+
+config SPRD_USB_BRINGUP
+	bool "Power up the SC7730 USB PHY for dwc2 (bring-up hack)"
+	depends on ARCH_SPRD && USB_DWC2
+	select SPRD_ADI
+	help
+	  Switches on the SC2723 USB LDO, the USB PHY, its AHB clock and
+	  resets, then writes the PHY tune value, following the vendor
+	  kernel. Stop-gap until clock, PHY and regulator drivers exist.
+
+config SPRD_RESTART
+	bool "Restart through the SC2723 PMIC watchdog"
+	depends on ARCH_SPRD
+	select SPRD_ADI
+	help
+	  Restart handler for the SC7730: leaves the boot mode for the
+	  bootloader ("reboot recovery" boots the recovery partition) and
+	  lets the PMIC watchdog reset the system, as the vendor kernel does.
+
+config SPRD_CLK_CPU
+	bool "SC7730 CPU cluster clock (bring-up glue)"
+	depends on ARCH_SPRD && COMMON_CLK
+	help
+	  The Cortex-A7 cluster clock from MPLL with a TDPLL detour while
+	  MPLL relocks, for CPU frequency scaling. Stop-gap until there is a
+	  clock driver for the SC7730.
+
+config SPRD_SC2723_DCDC_ARM
+	bool "SC2723 DCDC_ARM CPU supply as a regulator (bring-up glue)"
+	depends on ARCH_SPRD && REGULATOR
+	select SPRD_ADI
+	help
+	  The Cortex-A7 cluster supply of the SC2723 PMIC, set over the ADI
+	  bus, for CPU frequency scaling.
+
+config SPRD_CLK_AUX0
+	bool "SC7730 CLK_AUX0 32 kHz output (bring-up glue)"
+	depends on ARCH_SPRD && COMMON_CLK
+	help
+	  Gate clock for the CLK_AUX0 pad, the 32 kHz low power clock of
+	  the Broadcom WLAN chip on the Galaxy Tab E. Stop-gap until there
+	  is a clock driver for the SC7730.
+
+config SPRD_CLK_GATES
+	bool "SC7730 enable registers as gate clocks (bring-up glue)"
+	depends on ARCH_SPRD && COMMON_CLK
+	help
+	  The 32 enable bits of a gate register as clocks, for drivers that
+	  want an "enable" clock (sprd_serial on UART0 for Bluetooth).
+	  Stop-gap until there is a clock driver for the SC7730.
+
+config SPRD_SC2723_LDO
+	bool "SC2723 PMIC LDOs as regulators (bring-up glue)"
+	depends on ARCH_SPRD && REGULATOR
+	select SPRD_ADI
+	help
+	  LDOs of the SC2723 PMIC, one device tree node each, switched and
+	  set over the ADI bus: the microSD card supply, later the camera
+	  rails.
+
+config SPRD_SC7730_PM_DOMAINS
+	bool "SC7730 PMU power domains (bring-up glue)"
+	depends on ARCH_SPRD && PM && OF
+	select PM_GENERIC_DOMAINS
+	help
+	  The GPU_TOP and MM_TOP power domains of the SC7730 PMU as generic
+	  PM domains, for lima on the Mali-400 MP2 and later the camera.
+	  Also programs the GPU core clock on power-up. Stop-gap until
+	  there are power domain and clock drivers for this SoC.
+
+config SPRD_CPROC
+	bool "SC7730 modem (CP) loader and control"
+	depends on ARCH_SPRD && OF
+	help
+	  Loads and starts the modem core (CP) of the SC7730 through
+	  /proc/cpw (modem, dsp, start, stop, status, wdtirq, mem), as the
+	  Samsung 3.10 kernel does, for the SM-T561 (3G) and for tests on
+	  the Wi-Fi model, which carries the same modem firmware. Ported
+	  from sprd_cproc.c of the Samsung kernel sources (GPL-2.0).
+
+config SPRD_SIPC
+	bool "Spreadtrum SIPC shared-memory IPC with the modem"
+	depends on ARCH_SPRD && OF
+	select NET
+	help
+	  Message rings (smsg), the shared memory pool (smem), data
+	  channels (sbuf, sblock) and the spipe, stty and seth devices
+	  between the application processor and the modem core of the
+	  SC7730 (SM-T561 3G). Ported from the Samsung 3.10 kernel sources
+	  (GPL-2.0).
+
+config SPRD_SC2723_PMIC
+	bool "SC2723 PMIC regmap and interrupts (bring-up glue)"
+	depends on ARCH_SPRD && OF
+	select SPRD_ADI
+	select REGMAP
+	select REGMAP_IRQ
+	help
+	  The SC2723 PMIC as a regmap over the ADI bus, with its interrupt
+	  controller, for the mainline sc27xx RTC (RTC_DRV_SC27XX) and PMIC
+	  EIC (GPIO_PMIC_EIC_SPRD, power and volume down keys) drivers.
+	  Stand-in for spi-sprd-adi plus the sc27xx MFD, which do not know
+	  the SC7730/SC2723 yet.
+
+config SPRD_SC2723_ADC
+	bool "SC2723 PMIC auxiliary ADC (bring-up glue)"
+	depends on ARCH_SPRD && IIO
+	select SPRD_ADI
+	help
+	  Raw counts of the SC2723's auxiliary ADC as IIO channels, over the
+	  ADI bus. The fuel gauge reads the battery thermistor through it.
+
+config SPRD_SC2723_FGU
+	bool "SC2723 PMIC fuel gauge as battery supply (bring-up glue)"
+	depends on ARCH_SPRD && POWER_SUPPLY && IIO
+	select SPRD_ADI
+	help
+	  Battery voltage, current, state of charge and (with an ADC channel)
+	  temperature from the fuel gauge of the SC2723 PMIC, polled over the
+	  ADI bus, until the mainline sc27xx drivers support the SC2723.
+
+config SPRD_ADI
+	bool
+
 menuconfig ARCH_SUNPLUS
 	bool "Sunplus SoCs"
 	depends on ARCH_MULTI_V7
