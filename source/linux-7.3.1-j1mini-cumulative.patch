diff --git a/arch/arm/mach-sprd/sipc/sblock.c b/arch/arm/mach-sprd/sipc/sblock.c
new file mode 100755
index 000000000..c5b0ac291
--- /dev/null
+++ b/arch/arm/mach-sprd/sipc/sblock.c
@@ -0,0 +1,848 @@
