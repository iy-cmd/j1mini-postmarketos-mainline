diff --git a/arch/arm/mach-sprd/adi.c b/arch/arm/mach-sprd/adi.c
new file mode 100644
index 000000000..fee6c592f
--- /dev/null
+++ b/arch/arm/mach-sprd/adi.c
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal access to the SC2723 PMIC behind the Spreadtrum ADI bus, for
+ * the bring-up code in this directory (USB LDO, restart).
+ *
+ * Protocol from the vendor 3.10 kernel (arch/arm/mach-sc/adi.c), register
+ * offsets as in mainline drivers/spi/spi-sprd-adi.c:
+ *   read:  write the slave's physical address to RD_CMD, poll RD_DATA
+ *          until bit 31 clears, the value is in bits 15:0
+ *   write: plain MMIO store into the slave window, then wait until the
+ *          write FIFO is empty
+ */
+
+#include <linux/bits.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/spinlock.h>
+
+#include "adi.h"
+
+#define ADI_PHYS		0x40030000
+#define ADI_RD_CMD		0x24
+#define ADI_RD_DATA		0x28
+#define ADI_RD_BUSY		BIT(31)
+#define ADI_FIFO_STS		0x2c
+#define ADI_FIFO_EMPTY		BIT(10)
+#define ADI_SLAVE_PHYS		0x40038000
+#define ADI_SLAVE_SIZE		0x1000
+
+static void __iomem *adi, *slave;
+static DEFINE_RAW_SPINLOCK(adi_lock);
+
+static int __adi_read(u32 reg, u32 *val)
+{
+	int i;
+
+	writel(ADI_SLAVE_PHYS + reg, adi + ADI_RD_CMD);
+	for (i = 0; i < 2000; i++) {
+		u32 v = readl(adi + ADI_RD_DATA);
+
+		if (!(v & ADI_RD_BUSY)) {
+			*val = v & 0xffff;
+			return 0;
+		}
+		udelay(1);
+	}
+	return -ETIMEDOUT;
+}
+
+static int __adi_write(u32 reg, u32 val)
+{
+	int i;
+
+	writel(val, slave + reg);
+	for (i = 0; i < 1000; i++) {
+		if (readl(adi + ADI_FIFO_STS) & ADI_FIFO_EMPTY)
+			return 0;
+		udelay(1);
+	}
+	return -ETIMEDOUT;
+}
+
+int sprd_adi_read(u32 reg, u32 *val)
+{
+	unsigned long flags;
+	int ret;
+
+	if (!adi)
+		return -ENODEV;
+	raw_spin_lock_irqsave(&adi_lock, flags);
+	ret = __adi_read(reg, val);
+	raw_spin_unlock_irqrestore(&adi_lock, flags);
+	return ret;
+}
+
+int sprd_adi_write(u32 reg, u32 val)
+{
+	unsigned long flags;
+	int ret;
+
+	if (!adi)
+		return -ENODEV;
+	raw_spin_lock_irqsave(&adi_lock, flags);
+	ret = __adi_write(reg, val);
+	raw_spin_unlock_irqrestore(&adi_lock, flags);
+	return ret;
+}
+
+int sprd_adi_update(u32 reg, u32 clr, u32 set)
+{
+	unsigned long flags;
+	u32 v;
+	int ret;
+
+	if (!adi)
+		return -ENODEV;
+	raw_spin_lock_irqsave(&adi_lock, flags);
+	ret = __adi_read(reg, &v);
+	if (!ret)
+		ret = __adi_write(reg, (v & ~clr) | set);
+	raw_spin_unlock_irqrestore(&adi_lock, flags);
+	return ret;
+}
+
+static int __init sprd_adi_init(void)
+{
+	if (!of_machine_is_compatible("sprd,sc7730"))
+		return 0;
+	adi = ioremap(ADI_PHYS, 0x100);
+	slave = ioremap(ADI_SLAVE_PHYS, ADI_SLAVE_SIZE);
+	if (!adi || !slave) {
+		pr_err("sprd-adi: ioremap failed\n");
+		if (adi)
+			iounmap(adi);
+		adi = NULL;
+		return -ENOMEM;
+	}
+	return 0;
+}
+early_initcall(sprd_adi_init);
+
+#ifdef CONFIG_DEBUG_FS
+/*
+ * debugfs sprd-adi/{address,value}: PMIC registers from user space for
+ * bring-up (audio, camera rails), under the same lock as the drivers.
+ * /dev/mem must not be used for the ADI: a read is a command sequence and
+ * would race the fuel gauge polling.
+ */
+static u32 adi_dbg_addr;
+
+static int adi_dbg_get(void *data, u64 *val)
+{
+	u32 v;
+	int ret;
+
+	if (adi_dbg_addr >= ADI_SLAVE_SIZE || adi_dbg_addr & 3)
+		return -EINVAL;
+	ret = sprd_adi_read(adi_dbg_addr, &v);
+	*val = v;
+	return ret;
+}
+
+static int adi_dbg_set(void *data, u64 val)
+{
+	if (adi_dbg_addr >= ADI_SLAVE_SIZE || adi_dbg_addr & 3)
+		return -EINVAL;
+	return sprd_adi_write(adi_dbg_addr, val);
+}
+DEFINE_DEBUGFS_ATTRIBUTE(adi_dbg_fops, adi_dbg_get, adi_dbg_set, "0x%08llx\n");
+
+static int __init sprd_adi_debugfs_init(void)
+{
+	struct dentry *dir;
+
+	if (!adi)
+		return 0;
+	dir = debugfs_create_dir("sprd-adi", NULL);
+	debugfs_create_x32("address", 0600, dir, &adi_dbg_addr);
+	debugfs_create_file_unsafe("value", 0600, dir, NULL, &adi_dbg_fops);
+	return 0;
+}
+late_initcall(sprd_adi_debugfs_init);
+#endif
diff --git a/arch/arm/mach-sprd/adi.h b/arch/arm/mach-sprd/adi.h
new file mode 100644
index 000000000..f6cd8629f
--- /dev/null
+++ b/arch/arm/mach-sprd/adi.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __MACH_SPRD_ADI_H
+#define __MACH_SPRD_ADI_H
+
+#include <linux/types.h>
+
+/*
+ * Registers of the SC2723 PMIC, as offsets into the ADI slave window
+ * (0x40038000). Bring-up helpers until mainline spi-sprd-adi and a
+ * proper SC2723 MFD driver take over.
+ */
+#define SC2723_WDG(x)	(0x040 + (x))	/* PMIC watchdog */
+#define SC2723_GLB(x)	(0x800 + (x))	/* global registers */
+
+int sprd_adi_read(u32 reg, u32 *val);
+int sprd_adi_write(u32 reg, u32 val);
+int sprd_adi_update(u32 reg, u32 clr, u32 set);
+
+#endif
diff --git a/arch/arm/mach-sprd/bootstripes.c b/arch/arm/mach-sprd/bootstripes.c
new file mode 100644
index 000000000..5ee60ed75
--- /dev/null
+++ b/arch/arm/mach-sprd/bootstripes.c
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Boot progress stripes for Spreadtrum bring-up without serial console.
+ *
+ * The Spreadtrum bootloader leaves its splash screen running (MIPI DSI
+ * video mode keeps scanning out) and passes the buffer address as
+ * "lcd_base=<hex>". We take that buffer out of the linear map early,
+ * then paint one full-width white band per boot stage reached. White is
+ * used on purpose: it looks the same whatever the pixel channel order.
+ *
+ * Screen layout (800x1280 portrait, 32 bpp):
+ *   stage n  -> band at y = 64 + n * 112, 80 px high
+ *   panic    -> checkerboard over the bottom 160 lines
+ */
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/memblock.h>
+#include <linux/notifier.h>
+#include <linux/panic_notifier.h>
+#include <linux/sprd-bootstripes.h>
+
+static unsigned int fb_w = 800;
+static unsigned int fb_h = 1280;
+#define FB_SIZE		(fb_w * fb_h * 4)
+#define BAND_Y(n)	(64 + (n) * (fb_h > 1000 ? 112 : 70))
+#define BAND_H		(fb_h > 1000 ? 80 : 50)
+
+/* Fallbacks: buffer reserved for display */
+#define DT_LCD_BASE	0x9ea44000
+#define J1_LCD_BASE	0x9f197000
+static phys_addr_t lcd_base = DT_LCD_BASE;
+static u32 __iomem *fb;
+
+/*
+ * early_param handlers run from setup_arch() before paging_init(), so
+ * the buffer can still be removed from the linear map here. That is
+ * required: ARM refuses ioremap() of RAM that is linearly mapped, and the
+ * kernel must never hand out the pages the display is scanning out.
+ * The device tree reserves the usual buffer (no-map) itself; reserving it
+ * here as well makes its reserved-memory node fail, so only a buffer at
+ * another address is taken out here.
+ */
+static int __init sprd_lcd_base_setup(char *s)
+{
+	unsigned long v;
+
+	if (!s || kstrtoul(s, 16, &v) || !v)
+		return 0;
+	lcd_base = v;
+	if (lcd_base >= 0x9f000000) {
+		fb_w = 480;
+		fb_h = 800;
+	}
+	if (lcd_base == DT_LCD_BASE || lcd_base == J1_LCD_BASE)
+		return 0;
+	memblock_reserve(lcd_base, PAGE_ALIGN(FB_SIZE));
+	memblock_mark_nomap(lcd_base, PAGE_ALIGN(FB_SIZE));
+	return 0;
+}
+early_param("lcd_base", sprd_lcd_base_setup);
+
+static void fill_rows(int y0, int h, u32 pat_a, u32 pat_b)
+{
+	int x, y;
+
+	for (y = y0; y < y0 + h && y < fb_h; y++)
+		for (x = 0; x < fb_w; x++)
+			writel_relaxed(((x / 40 + y / 40) & 1) ? pat_b : pat_a,
+				       fb + y * fb_w + x);
+	wmb();
+}
+
+static bool sprd_fb_map(void)
+{
+	if (fb)
+		return true;
+	fb = ioremap_wc(lcd_base, FB_SIZE);
+	if (!fb)
+		return false;
+	fill_rows(0, fb_h, 0, 0);		/* clear the splash screen */
+	return true;
+}
+
+void sprd_bootstripe(enum sprd_bootstripe_stage stage)
+{
+	if (!sprd_fb_map())
+		return;
+	fill_rows(BAND_Y(stage), BAND_H, ~0U, ~0U);
+}
+
+void sprd_bootstripe_timer_irq(void)
+{
+	static bool seen;
+
+	if (seen)
+		return;
+	seen = true;
+	sprd_bootstripe(SPRD_STRIPE_TIMER_IRQ);
+}
+
+static int sprd_bootstripe_panic(struct notifier_block *nb,
+				 unsigned long event, void *unused)
+{
+	if (sprd_fb_map())
+		fill_rows(fb_h - 160, 160, ~0U, 0);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block sprd_bootstripe_panic_nb = {
+	.notifier_call = sprd_bootstripe_panic,
+};
+
+static int __init sprd_bootstripe_panic_init(void)
+{
+	atomic_notifier_chain_register(&panic_notifier_list,
+				       &sprd_bootstripe_panic_nb);
+	return 0;
+}
+early_initcall(sprd_bootstripe_panic_init);
diff --git a/arch/arm/mach-sprd/clk-aux0.c b/arch/arm/mach-sprd/clk-aux0.c
new file mode 100644
index 000000000..154d3168b
--- /dev/null
+++ b/arch/arm/mach-sprd/clk-aux0.c
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The CLK_AUX0 output of the SC7730, on the gtelwifi the 32 kHz low power
+ * clock (LPO) of the BCM43430 WLAN chip. A gate (AON APB EB1 bit 2) on the
+ * external 32 kHz clock, with source and divider in AON_CGM_CFG set to
+ * 32 kHz / 1 as in the vendor board file. The bootloader leaves the gate
+ * off and already muxes the pad to CLK_AUX0.
+ *
+ * Bring-up glue until there is a clock driver for this SoC.
+ */
+
+#include <linux/bits.h>
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define AON_APB_EB1		0x0004
+#define AON_EB1_AUX0_BIT	2
+#define AON_CGM_CFG		0x3020
+#define AON_CGM_AUX0_SEL	GENMASK(3, 0)	/* 0: 32 kHz */
+#define AON_CGM_AUX0_DIV	GENMASK(19, 16)	/* 0: divide by 1 */
+
+static DEFINE_SPINLOCK(sc7730_aux0_lock);
+
+static int sc7730_aux0_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	void __iomem *aon;
+	const char *parent;
+	struct clk_hw *hw;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+	/* shared with other blocks, so no request_mem_region */
+	aon = devm_ioremap(dev, res->start, resource_size(res));
+	if (!aon)
+		return -ENOMEM;
+
+	parent = of_clk_get_parent_name(dev->of_node, 0);
+	if (!parent)
+		return dev_err_probe(dev, -EINVAL, "no parent clock\n");
+
+	writel(readl(aon + AON_CGM_CFG) &
+	       ~(AON_CGM_AUX0_SEL | AON_CGM_AUX0_DIV), aon + AON_CGM_CFG);
+
+	hw = devm_clk_hw_register_gate(dev, "aux0", parent, 0,
+				       aon + AON_APB_EB1, AON_EB1_AUX0_BIT, 0,
+				       &sc7730_aux0_lock);
+	if (IS_ERR(hw))
+		return PTR_ERR(hw);
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_simple_get, hw);
+}
+
+static const struct of_device_id sc7730_aux0_of_match[] = {
+	{ .compatible = "sprd,sc7730-aux0-clk" },
+	{ }
+};
+
+static struct platform_driver sc7730_aux0_driver = {
+	.probe = sc7730_aux0_probe,
+	.driver = {
+		.name = "sc7730-aux0-clk",
+		.of_match_table = sc7730_aux0_of_match,
+	},
+};
+builtin_platform_driver(sc7730_aux0_driver);
diff --git a/arch/arm/mach-sprd/clk-cpu.c b/arch/arm/mach-sprd/clk-cpu.c
new file mode 100644
index 000000000..069f65aaf
--- /dev/null
+++ b/arch/arm/mach-sprd/clk-cpu.c
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cortex-A7 cluster clock of the SC7730 for CPU frequency scaling.
+ *
+ * CA7_CKG_CFG (AP AHB 0x20d03000) selects the core source (bits 2:0,
+ * 3 = TDPLL 768 MHz, 6 = MPLL) and a core divider (bits 6:4, kept at 0);
+ * the AXI divider (bits 10:8) stays at the SPL's core/3 up to 1.5 GHz and
+ * goes to core/4 above, so AXI never runs faster than the 500 MHz the SPL
+ * itself uses; the debug divider (core/7) is left alone. MPLL_CFG1 (AON
+ * APB 0x402e3070) sets
+ * MPLL = 26 MHz * (NINT + KINT / 2^20) with DIV_S set by the SPL.
+ *
+ * As in the vendor kernel (drivers/clk/clk-sc.c), a rate change parks the
+ * core on TDPLL, reprograms MPLL, waits 50 us per 100 MHz of change (there
+ * is no lock bit) and switches back. 768 MHz runs from TDPLL directly.
+ * MPLL feeds nothing else we use.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/mod_devicetable.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define CA7_CKG_SEL		GENMASK(2, 0)
+#define  CKG_SEL_26M		0
+#define  CKG_SEL_TDPLL		3
+#define  CKG_SEL_MPLL		6
+#define CA7_CKG_DIV		GENMASK(6, 4)
+#define CA7_AXI_DIV		GENMASK(10, 8)
+#define  AXI_DIV_3		2
+#define  AXI_DIV_4		3
+
+#define MPLL_NINT		GENMASK(5, 0)
+#define MPLL_SDM_EN		BIT(6)
+#define MPLL_DIV_S		BIT(10)
+#define MPLL_KINT		GENMASK(31, 12)
+
+#define REF_HZ			26000000UL
+#define TDPLL_HZ		768000000UL
+#define MPLL_MIN_HZ		(REF_HZ * 30)	/* 780 MHz */
+#define MPLL_MAX_HZ		(REF_HZ * 63)	/* NINT is 6 bits: 1638 MHz */
+#define AXI_DIV3_MAX_HZ		1500000000UL
+
+struct sc7730_cpu_clk {
+	struct clk_hw hw;
+	void __iomem *ckg;
+	void __iomem *mpll;
+};
+
+#define to_cpu_clk(_hw) container_of(_hw, struct sc7730_cpu_clk, hw)
+
+static unsigned long sc7730_mpll_rate(u32 cfg1)
+{
+	u64 rate = (u64)REF_HZ * FIELD_GET(MPLL_NINT, cfg1);
+
+	if (cfg1 & MPLL_SDM_EN)
+		rate += div_u64((u64)REF_HZ * FIELD_GET(MPLL_KINT, cfg1),
+				1 << 20);
+	return rate;
+}
+
+/* to the kHz: KINT leaves odd Hz that cpufreq would not find in the table */
+static unsigned long sc7730_cpu_clk_recalc_rate(struct clk_hw *hw,
+						unsigned long parent_rate)
+{
+	struct sc7730_cpu_clk *cc = to_cpu_clk(hw);
+	u32 ckg = readl(cc->ckg);
+	unsigned long rate;
+
+	switch (FIELD_GET(CA7_CKG_SEL, ckg)) {
+	case CKG_SEL_MPLL:
+		rate = sc7730_mpll_rate(readl(cc->mpll));
+		break;
+	case CKG_SEL_TDPLL:
+		rate = TDPLL_HZ;
+		break;
+	case CKG_SEL_26M:
+		rate = REF_HZ;
+		break;
+	default:
+		return 0;
+	}
+	rate /= FIELD_GET(CA7_CKG_DIV, ckg) + 1;
+	return DIV_ROUND_CLOSEST(rate, 1000) * 1000;
+}
+
+static int sc7730_cpu_clk_determine_rate(struct clk_hw *hw,
+					 struct clk_rate_request *req)
+{
+	if (req->rate <= TDPLL_HZ)
+		req->rate = TDPLL_HZ;
+	else
+		req->rate = clamp(req->rate, MPLL_MIN_HZ, MPLL_MAX_HZ);
+	return 0;
+}
+
+static void sc7730_cpu_clk_select(struct sc7730_cpu_clk *cc, u32 sel,
+				  u32 axi_div)
+{
+	u32 ckg = readl(cc->ckg);
+
+	ckg &= ~(CA7_CKG_SEL | CA7_CKG_DIV | CA7_AXI_DIV);
+	writel(ckg | FIELD_PREP(CA7_CKG_SEL, sel) |
+	       FIELD_PREP(CA7_AXI_DIV, axi_div), cc->ckg);
+}
+
+static int sc7730_cpu_clk_set_rate(struct clk_hw *hw, unsigned long rate,
+				   unsigned long parent_rate)
+{
+	struct sc7730_cpu_clk *cc = to_cpu_clk(hw);
+	u32 axi_div = rate > AXI_DIV3_MAX_HZ ? AXI_DIV_4 : AXI_DIV_3;
+	u32 cfg1 = readl(cc->mpll), new;
+	unsigned long old_hz, nint, kint, delta;
+
+	sc7730_cpu_clk_select(cc, CKG_SEL_TDPLL, AXI_DIV_3);
+	if (rate == TDPLL_HZ)
+		return 0;
+
+	nint = rate / REF_HZ;
+	kint = DIV_ROUND_CLOSEST_ULL((u64)(rate - nint * REF_HZ) << 20,
+				     REF_HZ);
+	new = cfg1 & ~(MPLL_NINT | MPLL_KINT | MPLL_SDM_EN);
+	new |= FIELD_PREP(MPLL_NINT, nint) | MPLL_DIV_S;
+	if (kint)
+		new |= FIELD_PREP(MPLL_KINT, kint) | MPLL_SDM_EN;
+
+	if (new != cfg1) {
+		old_hz = sc7730_mpll_rate(cfg1);
+		writel(new, cc->mpll);
+		delta = abs_diff(old_hz, sc7730_mpll_rate(new)) / 1000000;
+		/* vendor: 50 us per 100 MHz; never less than 100 us */
+		fsleep(max(100UL, delta / 2));
+	}
+
+	sc7730_cpu_clk_select(cc, CKG_SEL_MPLL, axi_div);
+	return 0;
+}
+
+static const struct clk_ops sc7730_cpu_clk_ops = {
+	.recalc_rate = sc7730_cpu_clk_recalc_rate,
+	.determine_rate = sc7730_cpu_clk_determine_rate,
+	.set_rate = sc7730_cpu_clk_set_rate,
+};
+
+static int sc7730_cpu_clk_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_init_data init = {};
+	struct sc7730_cpu_clk *cc;
+	struct resource *res;
+	u32 cfg1;
+	int ret;
+
+	cc = devm_kzalloc(dev, sizeof(*cc), GFP_KERNEL);
+	if (!cc)
+		return -ENOMEM;
+
+	/* both registers sit in blocks shared with other drivers */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "ckg");
+	if (res)
+		cc->ckg = devm_ioremap(dev, res->start, resource_size(res));
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "mpll");
+	if (res)
+		cc->mpll = devm_ioremap(dev, res->start, resource_size(res));
+	if (!cc->ckg || !cc->mpll)
+		return dev_err_probe(dev, -EINVAL, "missing ckg/mpll\n");
+
+	cfg1 = readl(cc->mpll);
+	if (!(cfg1 & MPLL_DIV_S))
+		return dev_err_probe(dev, -ENODEV,
+				     "MPLL not in NINT/KINT mode (%#x)\n", cfg1);
+
+	init.name = "cpu";
+	init.ops = &sc7730_cpu_clk_ops;
+	init.flags = CLK_IS_CRITICAL | CLK_GET_RATE_NOCACHE;
+	cc->hw.init = &init;
+
+	ret = devm_clk_hw_register(dev, &cc->hw);
+	if (ret)
+		return ret;
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_simple_get, &cc->hw);
+}
+
+static const struct of_device_id sc7730_cpu_clk_of_match[] = {
+	{ .compatible = "sprd,sc7730-cpu-clk" },
+	{ }
+};
+
+static struct platform_driver sc7730_cpu_clk_driver = {
+	.probe = sc7730_cpu_clk_probe,
+	.driver = {
+		.name = "sc7730-cpu-clk",
+		.of_match_table = sc7730_cpu_clk_of_match,
+	},
+};
+builtin_platform_driver(sc7730_cpu_clk_driver);
diff --git a/arch/arm/mach-sprd/clk-gates.c b/arch/arm/mach-sprd/clk-gates.c
new file mode 100644
index 000000000..70663b916
--- /dev/null
+++ b/arch/arm/mach-sprd/clk-gates.c
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * A bank of 32 enable bits of the SC7730 as gate clocks, "#clock-cells =
+ * <1>" with the bit number, e.g. the AP APB gates at 0x71300000 for the
+ * "enable" clock that mainline sprd_serial wants for UART0 (bit 13).
+ *
+ * Other drivers in mach-sprd still set their bits in the same registers
+ * directly (INTC, I2C1), so every gate is CLK_IGNORE_UNUSED: switching
+ * off "unused" gates at late init would cut blocks that are in use.
+ *
+ * Bring-up glue until there is a clock driver for this SoC.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define SC7730_GATES	32
+
+static DEFINE_SPINLOCK(sc7730_gates_lock);
+
+static int sc7730_gates_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_hw_onecell_data *data;
+	const char *parent, *name;
+	struct resource *res;
+	void __iomem *reg;
+	int i;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+	/* shared with other drivers, so no request_mem_region */
+	reg = devm_ioremap(dev, res->start, resource_size(res));
+	if (!reg)
+		return -ENOMEM;
+
+	parent = of_clk_get_parent_name(dev->of_node, 0);
+	data = devm_kzalloc(dev, struct_size(data, hws, SC7730_GATES),
+			    GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	data->num = SC7730_GATES;
+
+	for (i = 0; i < SC7730_GATES; i++) {
+		name = devm_kasprintf(dev, GFP_KERNEL, "%s-%d", dev_name(dev), i);
+		if (!name)
+			return -ENOMEM;
+		data->hws[i] = devm_clk_hw_register_gate(dev, name, parent,
+							 CLK_IGNORE_UNUSED, reg,
+							 i, 0, &sc7730_gates_lock);
+		if (IS_ERR(data->hws[i]))
+			return PTR_ERR(data->hws[i]);
+	}
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, data);
+}
+
+static const struct of_device_id sc7730_gates_of_match[] = {
+	{ .compatible = "sprd,sc7730-gates" },
+	{ }
+};
+
+static struct platform_driver sc7730_gates_driver = {
+	.probe = sc7730_gates_probe,
+	.driver = {
+		.name = "sc7730-gates",
+		.of_match_table = sc7730_gates_of_match,
+	},
+};
+builtin_platform_driver(sc7730_gates_driver);
diff --git a/arch/arm/mach-sprd/cproc.c b/arch/arm/mach-sprd/cproc.c
new file mode 100644
index 000000000..a7997a513
--- /dev/null
+++ b/arch/arm/mach-sprd/cproc.c
@@ -0,0 +1,411 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Modem core (CP) loader and control of the SC7730, ported from
+ * drivers/misc/sprd_cproc/sprd_cproc.c of Samsung's 3.10 kernel sources
+ * (Copyright (C) 2012 Spreadtrum Communications Inc., GPL-2.0).
+ *
+ * The /proc/<name> interface is the one the Spreadtrum userspace uses
+ * (modem_control): write the firmware images to "modem" and "dsp", write
+ * "start" to boot the core, read "wdtirq" to wait for its watchdog.
+ *
+ *   start    boots the core: copies a 3-word jump routine to IRAM1 that
+ *            branches to the modem image, then releases the core in the
+ *            PMU (clear force-shutdown, clear force-deep-sleep, pulse
+ *            reset)
+ *   stop     puts the core back into reset, deep sleep and shutdown
+ *   modem    firmware image window (written at the offset of the file)
+ *   dsp      DSP image window
+ *   mem      the whole CP memory, read only
+ *   status   "started", "stopped" or "wdtirq"
+ *   wdtirq   blocks until the CP watchdog fired, then returns "wdtirq"
+ *
+ * Device tree: see Documentation/devicetree/bindings/misc/sprd,scproc.yaml.
+ */
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/poll.h>
+#include <linux/proc_fs.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+
+enum { CTRL_SHUT_DOWN, CTRL_DEEP_SLEEP, CTRL_RESET, CTRL_STATUS, CTRL_NR };
+enum { ST_STARTED, ST_STOPPED, ST_WDTIRQ };
+static const char *const st_text[] = { "started\n", "stopped\n", "wdtirq\n" };
+
+#define IRAM_WORDS	3
+#define CHUNK		SZ_64K
+
+struct cproc_seg {
+	const char *name;
+	phys_addr_t base;
+	size_t size;
+};
+
+struct cproc {
+	struct device *dev;
+	const char *name;
+	phys_addr_t base;
+	size_t size;
+	phys_addr_t iram;
+	void __iomem *pmu;
+	u32 reg[CTRL_NR];
+	u32 mask[CTRL_NR];
+	u32 iram_data[IRAM_WORDS];
+	struct cproc_seg seg[2];	/* modem, dsp */
+	int status;
+	bool wdt;
+	wait_queue_head_t wait;
+	struct mutex lock;
+	struct proc_dir_entry *dir;
+};
+
+static void cp_pmu_set(struct cproc *c, int which)
+{
+	u32 v = readl(c->pmu + c->reg[which]);
+
+	writel(v | c->mask[which], c->pmu + c->reg[which]);
+}
+
+static void cp_pmu_clr(struct cproc *c, int which)
+{
+	u32 v = readl(c->pmu + c->reg[which]);
+
+	writel(v & ~c->mask[which], c->pmu + c->reg[which]);
+}
+
+static int cp_start(struct cproc *c)
+{
+	void __iomem *iram;
+	int i;
+
+	iram = ioremap(c->iram, 0x1000);
+	if (!iram)
+		return -ENOMEM;
+	for (i = 0; i < IRAM_WORDS; i++)
+		writel(c->iram_data[i], iram + 4 * i);
+	iounmap(iram);
+
+	cp_pmu_clr(c, CTRL_SHUT_DOWN);
+	msleep(50);
+	cp_pmu_clr(c, CTRL_DEEP_SLEEP);
+	msleep(50);
+	cp_pmu_set(c, CTRL_RESET);
+	msleep(200);
+	cp_pmu_clr(c, CTRL_RESET);
+	for (i = 0; i < 1000; i++) {
+		if (!(readl(c->pmu + c->reg[CTRL_RESET]) & c->mask[CTRL_RESET]))
+			break;
+		msleep(1);
+	}
+	if (i == 1000)
+		dev_warn(c->dev, "reset bit does not clear\n");
+	c->wdt = false;
+	c->status = ST_STARTED;
+	dev_info(c->dev, "%s started\n", c->name);
+	return 0;
+}
+
+static int cp_stop(struct cproc *c)
+{
+	int i;
+
+	/* wait until the core has gone to sleep (PMU 0xb4 bit 0) */
+	for (i = 0; i < 500; i++) {
+		if (readl(c->pmu + 0xb4) & 1)
+			break;
+		msleep(1);
+	}
+	if (i == 500)
+		dev_warn(c->dev, "core does not enter sleep, stopping anyway\n");
+	cp_pmu_set(c, CTRL_RESET);
+	cp_pmu_set(c, CTRL_DEEP_SLEEP);
+	cp_pmu_set(c, CTRL_SHUT_DOWN);
+	c->status = ST_STOPPED;
+	dev_info(c->dev, "%s stopped\n", c->name);
+	return 0;
+}
+
+static irqreturn_t cp_wdt_irq(int irq, void *data)
+{
+	struct cproc *c = data;
+
+	dev_err(c->dev, "%s watchdog fired\n", c->name);
+	c->wdt = true;
+	c->status = ST_WDTIRQ;
+	wake_up_interruptible_all(&c->wait);
+	return IRQ_HANDLED;
+}
+
+/* copy between user space and CP memory, a chunk at a time */
+static ssize_t cp_copy(phys_addr_t base, size_t size, char __user *ubuf,
+		       const char __user *cbuf, size_t count, loff_t *ppos)
+{
+	loff_t pos = *ppos;
+	size_t done = 0;
+	void *tmp;
+
+	if (pos >= size)
+		return 0;
+	count = min_t(size_t, count, size - pos);
+	tmp = kmalloc(CHUNK, GFP_KERNEL);
+	if (!tmp)
+		return -ENOMEM;
+	while (done < count) {
+		size_t n = min_t(size_t, CHUNK, count - done);
+		void __iomem *m = memremap(base + pos + done, n, MEMREMAP_WC);
+
+		if (!m) {
+			kfree(tmp);
+			return done ? done : -ENOMEM;
+		}
+		if (ubuf) {
+			memcpy_fromio(tmp, m, n);
+			if (copy_to_user(ubuf + done, tmp, n)) {
+				memunmap(m);
+				kfree(tmp);
+				return done ? done : -EFAULT;
+			}
+		} else {
+			if (copy_from_user(tmp, cbuf + done, n)) {
+				memunmap(m);
+				kfree(tmp);
+				return done ? done : -EFAULT;
+			}
+			memcpy_toio(m, tmp, n);
+		}
+		memunmap(m);
+		done += n;
+	}
+	kfree(tmp);
+	*ppos += done;
+	return done;
+}
+
+enum { P_START, P_STOP, P_MODEM, P_DSP, P_STATUS, P_WDTIRQ, P_MEM, P_NR };
+static const char *const pname[P_NR] = {
+	"start", "stop", "modem", "dsp", "status", "wdtirq", "mem"
+};
+
+struct cp_file {
+	struct cproc *c;
+	int which;
+};
+
+static ssize_t cp_read(struct file *f, char __user *buf, size_t count, loff_t *ppos)
+{
+	struct cp_file *pf = pde_data(file_inode(f));
+	struct cproc *c = pf->c;
+	const char *t;
+	size_t len;
+
+	switch (pf->which) {
+	case P_MEM:
+		return cp_copy(c->base, c->size, buf, NULL, count, ppos);
+	case P_STATUS:
+		t = st_text[c->status];
+		break;
+	case P_WDTIRQ:
+		if (wait_event_interruptible(c->wait, c->wdt))
+			return -ERESTARTSYS;
+		t = st_text[ST_WDTIRQ];
+		break;
+	default:
+		return -EINVAL;
+	}
+	len = strlen(t);
+	if (*ppos >= len)
+		return 0;
+	count = min(count, len - (size_t)*ppos);
+	if (copy_to_user(buf, t + *ppos, count))
+		return -EFAULT;
+	*ppos += count;
+	return count;
+}
+
+static ssize_t cp_write(struct file *f, const char __user *buf, size_t count, loff_t *ppos)
+{
+	struct cp_file *pf = pde_data(file_inode(f));
+	struct cproc *c = pf->c;
+	struct cproc_seg *s;
+	ssize_t ret;
+
+	mutex_lock(&c->lock);
+	switch (pf->which) {
+	case P_START:
+		ret = cp_start(c);
+		break;
+	case P_STOP:
+		ret = cp_stop(c);
+		break;
+	case P_MODEM:
+	case P_DSP:
+		s = &c->seg[pf->which == P_DSP];
+		ret = cp_copy(s->base, s->size, NULL, buf, count, ppos);
+		if (ret == 0 && *ppos >= s->size) {
+			*ppos += count;	/* past the end: pretend to have written it */
+			ret = count;
+		}
+		mutex_unlock(&c->lock);
+		return ret;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&c->lock);
+	return ret ? ret : count;
+}
+
+static loff_t cp_lseek(struct file *f, loff_t off, int whence)
+{
+	struct cp_file *pf = pde_data(file_inode(f));
+	loff_t new;
+
+	switch (whence) {
+	case SEEK_SET:
+		new = off;
+		break;
+	case SEEK_CUR:
+		new = f->f_pos + off;
+		break;
+	case SEEK_END:
+		if (pf->which != P_MEM)
+			return -EINVAL;
+		new = pf->c->size + off;
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (new < 0)
+		return -EINVAL;
+	f->f_pos = new;
+	return new;
+}
+
+static __poll_t cp_poll(struct file *f, poll_table *wait)
+{
+	struct cp_file *pf = pde_data(file_inode(f));
+	struct cproc *c = pf->c;
+
+	if (pf->which != P_WDTIRQ)
+		return EPOLLERR;
+	poll_wait(f, &c->wait, wait);
+	return c->wdt ? EPOLLIN | EPOLLRDNORM : 0;
+}
+
+static const struct proc_ops cp_proc_ops = {
+	.proc_read	= cp_read,
+	.proc_write	= cp_write,
+	.proc_lseek	= cp_lseek,
+	.proc_poll	= cp_poll,
+};
+
+static int cp_parse_seg(struct device_node *np, struct cproc *c)
+{
+	struct device_node *ch;
+	int n = 0;
+
+	for_each_child_of_node(np, ch) {
+		struct resource res;
+		const char *name;
+
+		if (n >= 2 || of_property_read_string(ch, "cproc,name", &name) ||
+		    of_address_to_resource(ch, 0, &res)) {
+			of_node_put(ch);
+			return -EINVAL;
+		}
+		c->seg[n].name = name;
+		c->seg[n].base = res.start;
+		c->seg[n].size = resource_size(&res);
+		n++;
+	}
+	return n == 2 ? 0 : -EINVAL;
+}
+
+static int cproc_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct cproc *c;
+	struct resource res;
+	struct cp_file *files;
+	int irq, i, ret;
+
+	c = devm_kzalloc(&pdev->dev, sizeof(*c), GFP_KERNEL);
+	files = devm_kcalloc(&pdev->dev, P_NR, sizeof(*files), GFP_KERNEL);
+	if (!c || !files)
+		return -ENOMEM;
+	c->dev = &pdev->dev;
+	init_waitqueue_head(&c->wait);
+	mutex_init(&c->lock);
+	c->status = ST_STOPPED;
+
+	ret = of_property_read_string(np, "sprd,name", &c->name);
+	if (ret)
+		return ret;
+	ret = of_property_read_u32_array(np, "sprd,ctrl-reg", c->reg, CTRL_NR);
+	if (!ret)
+		ret = of_property_read_u32_array(np, "sprd,ctrl-mask", c->mask, CTRL_NR);
+	if (!ret)
+		ret = of_property_read_u32_array(np, "sprd,iram-data", c->iram_data, IRAM_WORDS);
+	if (ret)
+		return ret;
+	ret = cp_parse_seg(np, c);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "need a modem and a dsp child node\n");
+
+	if (of_address_to_resource(np, 0, &res))
+		return -EINVAL;
+	c->base = res.start;
+	c->size = resource_size(&res);
+	if (of_address_to_resource(np, 1, &res))
+		return -EINVAL;
+	c->iram = res.start;
+	c->pmu = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(c->pmu))
+		return PTR_ERR(c->pmu);
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(&pdev->dev, irq, cp_wdt_irq, 0, "cpw", c);
+	if (ret)
+		return ret;
+
+	c->dir = proc_mkdir(c->name, NULL);
+	if (!c->dir)
+		return -ENOMEM;
+	for (i = 0; i < P_NR; i++) {
+		files[i].c = c;
+		files[i].which = i;
+		if (!proc_create_data(pname[i], 0200, c->dir, &cp_proc_ops, &files[i])) {
+			remove_proc_subtree(c->name, NULL);
+			return -ENOMEM;
+		}
+	}
+	platform_set_drvdata(pdev, c);
+	dev_info(&pdev->dev, "%s: memory %pa+%zx, modem %pa+%zx, dsp %pa+%zx, /proc/%s\n",
+		 c->name, &c->base, c->size, &c->seg[0].base, c->seg[0].size,
+		 &c->seg[1].base, c->seg[1].size, c->name);
+	return 0;
+}
+
+static const struct of_device_id cproc_of_match[] = {
+	{ .compatible = "sprd,scproc" },
+	{ }
+};
+
+static struct platform_driver cproc_driver = {
+	.driver = {
+		.name = "sprd-cproc",
+		.of_match_table = cproc_of_match,
+		.suppress_bind_attrs = true,
+	},
+	.probe = cproc_probe,
+};
+builtin_platform_driver(cproc_driver);
diff --git a/arch/arm/mach-sprd/crng-hwrng.c b/arch/arm/mach-sprd/crng-hwrng.c
new file mode 100644
index 000000000..f87a85a2e
--- /dev/null
+++ b/arch/arm/mach-sprd/crng-hwrng.c
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * /dev/hw_random for the SC7730, which has no hardware RNG the kernel knows
+ * of (the vendor kernel has none either). Android's prng_seeder needs it:
+ * init creates the daemon's socket already listening, and without
+ * /dev/hw_random the daemon parks before accept(), so every process whose
+ * FIPS BoringSSL asks the daemon for its first seed blocks in read() forever.
+ *
+ * Serve the kernel's CRNG instead; prng_seeder conditions the bytes with its
+ * own DRBG anyway. Quality 1 (of 1024): the hwrng core feeds every rng back
+ * into the pool, these bytes must not be credited as entropy (0 would mean
+ * the default, full credit).
+ */
+#include <linux/hw_random.h>
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/random.h>
+
+static int sc7730_crng_read(struct hwrng *rng, void *buf, size_t max, bool wait)
+{
+	get_random_bytes(buf, max);
+	return max;
+}
+
+static struct hwrng sc7730_crng = {
+	.name = "sc7730-crng",
+	.read = sc7730_crng_read,
+	.quality = 1,
+};
+
+static int __init sc7730_crng_init(void)
+{
+	if (!of_machine_is_compatible("sprd,sc7730"))
+		return 0;
+	return hwrng_register(&sc7730_crng);
+}
+device_initcall(sc7730_crng_init);
diff --git a/arch/arm/mach-sprd/platsmp.c b/arch/arm/mach-sprd/platsmp.c
new file mode 100644
index 000000000..0235b76eb
--- /dev/null
+++ b/arch/arm/mach-sprd/platsmp.c
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Secondary CPU bring-up for the Spreadtrum SC7730 (4x Cortex-A7).
+ *
+ * Cores 1-3 come out of reset into the boot ROM (high vectors), which
+ * waits for their bit in the AP AHB HOLDING_PEN register and then jumps
+ * to JMP_ADDR_CA7_Cn. They start in the Secure world in SVC mode. Power
+ * comes from the PMU: PD_CA7_Cn_CFG with FORCE_SHUTDOWN clear powers a
+ * core up, the state nibble of PWR_STATUS0_DBG reads 0 when it is on and
+ * 7 when it is off. Sequence from the vendor 3.10 kernel
+ * (arch/arm/mach-sc/platsmp.c), confirmed by booting core 1 into a probe
+ * stub from user space. The vendor's software pen is not needed.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/smp.h>
+#include <linux/spinlock.h>
+
+#include <asm/cacheflush.h>
+#include <asm/cp15.h>
+#include <asm/smp_plat.h>
+
+#include "sc7730.h"
+
+#define AP_AHB_PHYS		0x20d00000
+#define AHB_CA7_RST_SET		0x0008		/* bits 3:0 core reset */
+#define AHB_HOLDING_PEN		0x0014		/* bit n releases core n */
+#define AHB_JMP_ADDR(n)		(0x0018 + 4 * (n))
+#define AHB_CA7_STANDBY		0x3034		/* bits 3:0 STANDBYWFI */
+
+#define PMU_PHYS		0x402b0000
+#define PMU_PD_CA7_C(n)		(0x0004 + 4 * (n))
+#define PD_FORCE_SHUTDOWN	BIT(25)
+#define PD_AUTO_SHUTDOWN_EN	BIT(24)
+#define PD_ON_DELAYS		0x00040404	/* power-on/sequence/isolation delays */
+#define PMU_PWR_STATUS0		0x00bc
+#define PD_STATE(v, n)		(((v) >> (4 * ((n) + 1))) & 0xf)
+#define PD_STATE_ON		0
+#define PD_STATE_OFF		7
+
+static void __iomem *ap_ahb, *pmu;
+static DEFINE_SPINLOCK(sc7730_smp_lock);
+
+static unsigned int sc7730_core(unsigned int cpu)
+{
+	return MPIDR_AFFINITY_LEVEL(cpu_logical_map(cpu), 0);
+}
+
+static void __init sc7730_smp_prepare_cpus(unsigned int max_cpus)
+{
+	/* shared with other users of these blocks, no request_mem_region */
+	ap_ahb = ioremap(AP_AHB_PHYS, 0x4000);
+	pmu = ioremap(PMU_PHYS, 0x100);
+	if (!ap_ahb || !pmu)
+		pr_err("sc7730-smp: cannot map AP AHB/PMU\n");
+}
+
+static int sc7730_boot_secondary(unsigned int cpu, struct task_struct *idle)
+{
+	unsigned int n = sc7730_core(cpu);
+	int i;
+
+	if (!ap_ahb || !pmu || n < 1 || n > 3)
+		return -ENODEV;
+
+	spin_lock(&sc7730_smp_lock);
+	/*
+	 * The ROM jumps with interworking, and secondary_startup_arm must be
+	 * entered in ARM state. The LLVM assembler marks it as a Thumb
+	 * function in a Thumb-2 kernel (its ENDPROC comes after the switch
+	 * to Thumb), so the address would carry bit 0 and the core would
+	 * start decoding ARM code as Thumb.
+	 */
+	writel(__pa_symbol(secondary_startup_arm) & ~1UL,
+	       ap_ahb + AHB_JMP_ADDR(n));
+	writel(readl(ap_ahb + AHB_HOLDING_PEN) | BIT(n),
+	       ap_ahb + AHB_HOLDING_PEN);
+	writel(readl(ap_ahb + AHB_CA7_RST_SET) | BIT(n),
+	       ap_ahb + AHB_CA7_RST_SET);
+	/* FORCE_SHUTDOWN clear powers the core up; AUTO_SHUTDOWN stays off */
+	writel(PD_ON_DELAYS, pmu + PMU_PD_CA7_C(n));
+	for (i = 0; i < 50; i++) {
+		if (PD_STATE(readl(pmu + PMU_PWR_STATUS0), n) == PD_STATE_ON)
+			break;
+		udelay(100);
+	}
+	writel(readl(ap_ahb + AHB_CA7_RST_SET) & ~BIT(n),
+	       ap_ahb + AHB_CA7_RST_SET);
+	spin_unlock(&sc7730_smp_lock);
+
+	/* the ROM pen may wait in WFE */
+	dsb_sev();
+	return 0;
+}
+
+static void sc7730_secondary_init(unsigned int cpu)
+{
+	sc7730_set_cntfrq();
+}
+
+#ifdef CONFIG_HOTPLUG_CPU
+static void sc7730_cpu_die(unsigned int cpu)
+{
+	v7_exit_coherency_flush(louis);
+	while (1)
+		wfi();
+}
+
+static int sc7730_cpu_kill(unsigned int cpu)
+{
+	unsigned int n = sc7730_core(cpu);
+	int i;
+
+	/* never cut power to a core that has not reached WFI */
+	for (i = 0; i < 100; i++) {
+		if (readl(ap_ahb + AHB_CA7_STANDBY) & BIT(n))
+			break;
+		usleep_range(100, 200);
+	}
+	if (!(readl(ap_ahb + AHB_CA7_STANDBY) & BIT(n)))
+		return 0;
+
+	spin_lock(&sc7730_smp_lock);
+	writel((readl(pmu + PMU_PD_CA7_C(n)) | PD_FORCE_SHUTDOWN) &
+	       ~PD_AUTO_SHUTDOWN_EN, pmu + PMU_PD_CA7_C(n));
+	spin_unlock(&sc7730_smp_lock);
+
+	for (i = 0; i < 100; i++) {
+		if (PD_STATE(readl(pmu + PMU_PWR_STATUS0), n) == PD_STATE_OFF)
+			return 1;
+		udelay(60);
+	}
+	return 0;
+}
+#endif
+
+static const struct smp_operations sc7730_smp_ops __initconst = {
+	.smp_prepare_cpus	= sc7730_smp_prepare_cpus,
+	.smp_secondary_init	= sc7730_secondary_init,
+	.smp_boot_secondary	= sc7730_boot_secondary,
+#ifdef CONFIG_HOTPLUG_CPU
+	.cpu_die		= sc7730_cpu_die,
+	.cpu_kill		= sc7730_cpu_kill,
+#endif
+};
+CPU_METHOD_OF_DECLARE(sc7730_smp, "sprd,sc7730-smp", &sc7730_smp_ops);
diff --git a/arch/arm/mach-sprd/pm-domains.c b/arch/arm/mach-sprd/pm-domains.c
new file mode 100644
index 000000000..5cbacceec
--- /dev/null
+++ b/arch/arm/mach-sprd/pm-domains.c
@@ -0,0 +1,266 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Power domains of the SC7730 PMU as generic PM domains, so that drivers
+ * get them through "power-domains" and runtime PM: GPU_TOP (Mali-400 MP2)
+ * and MM_TOP (camera, video).
+ *
+ * Each domain has a PD_*_CFG register in the PMU (0x402b0000): bit 25
+ * forces it off, bit 24 would let the PMU switch it off on its own in
+ * deep sleep (left off), bits 23:0 are power-up delays. Its state is a
+ * nibble in PWR_STATUS0_DBG, 0 = on, 7 = off. Behind the domain sits an
+ * AXI/AHB enable bit in AON_APB EB0 (0x402e0000). Sequence as in the vendor
+ * Mali glue (drivers/gpu/mali400/r4p1/platform/sc8830/mali_platform.c):
+ * delays 1/1/1, clear FORCE_SHUTDOWN, wait for state 0, 100 us, enable.
+ *
+ * The GPU's core clock mux lives inside the domain (GPU_APB CLK_CTRL at
+ * 0x60100004, SEL bits 2:0, DIV bits 5:4) and loses its setting with it,
+ * so it is programmed here on every power-up (the reset value is 256 MHz,
+ * TDPLL / 3). The rate comes from the gpu_khz parameter:
+ *
+ *   384000  SEL 5, TDPLL (768 MHz) / 2, always running
+ *   460800  SEL 6, WPLL (921.6 MHz) / 2, the vendor's maximum for this SoC
+ *   512000  SEL 4, CPLL / 2 (default); the SPL programs CPLL to 1024 MHz,
+ *           not the 624 MHz the vendor DT names (clk_312m) assume
+ *
+ * WPLL and CPLL belong to the modem and are powered down unless somebody
+ * votes for them (ANALOG_STATUS PD bits set; selecting one of them then
+ * hung the GPU bus, 01.11.). The AP votes through bit 0 of *PLL_REL_CFG in
+ * the PMU while the GPU domain is on and drops the vote with it, as the
+ * vendor Mali glue does by preparing all its source clocks. Measured with
+ * a GLES 2 fill-rate test (tools/lab/gpubench.c): 21.5 / 25.6 / 28.5 fps,
+ * 512 MHz stable over 3 minutes at the fixed vddcore of the SPL (05.11.).
+ * If the PLL does not come up, the GPU stays at 384 MHz. A new value
+ * takes effect at the next power-up of the domain. A clock driver would
+ * read the mux while the domain is off.
+ *
+ * Bring-up glue until there is a power domain driver for this SoC.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mod_devicetable.h>
+#include <linux/moduleparam.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/spinlock.h>
+
+#define PD_FORCE_SHUTDOWN	BIT(25)
+#define PD_AUTO_SHUTDOWN	BIT(24)
+#define PD_DELAYS_MASK		GENMASK(23, 0)
+#define PD_DELAYS		0x010101
+#define PWR_STATUS0_DBG		0xbc
+#define AON_APB_EB0		0x00
+
+#define GPU_APB_PHYS		0x60100000
+#define GPU_APB_CLK_CTRL	0x04
+#define GPU_CLK_SEL		GENMASK(2, 0)
+#define GPU_CLK_DIV		GENMASK(5, 4)
+#define GPU_CLK_SEL_384M	5
+
+#define ANALOG_STATUS_PHYS	0x402e3090
+#define WPLL_REL_CFG		0xa0
+#define CPLL_REL_CFG		0xa4
+#define PLL_AP_SEL		BIT(0)
+
+#undef MODULE_PARAM_PREFIX
+#define MODULE_PARAM_PREFIX "sc7730."
+
+static unsigned int gpu_khz = 512000;
+module_param(gpu_khz, uint, 0644);
+MODULE_PARM_DESC(gpu_khz, "GPU clock: 384000, 460800 or 512000 (next power-up)");
+
+/* GPU clock sources besides TDPLL / 2: modem PLL, its vote and PD flag */
+static const struct sc7730_gpu_src {
+	unsigned int khz;
+	u32 sel;
+	u32 rel_cfg;
+	u32 pd_bit;		/* in ANALOG_STATUS, 1 = powered down */
+} sc7730_gpu_srcs[] = {
+	{ 460800, 6, WPLL_REL_CFG, BIT(15) },
+	{ 512000, 4, CPLL_REL_CFG, BIT(17) },
+};
+
+enum { SC7730_PD_GPU, SC7730_PD_MM, SC7730_NR_PDS };
+
+struct sc7730_pd_data {
+	const char *name;
+	u32 cfg;		/* PD_*_CFG offset in the PMU */
+	u32 state_shift;	/* nibble in PWR_STATUS0_DBG */
+	u32 eb;			/* enable bit in AON_APB EB0 */
+};
+
+static const struct sc7730_pd_data sc7730_pd_data[SC7730_NR_PDS] = {
+	[SC7730_PD_GPU] = { "gpu", 0x20, 24, BIT(27) },
+	[SC7730_PD_MM]  = { "mm",  0x1c, 28, BIT(25) },
+};
+
+struct sc7730_pd {
+	struct generic_pm_domain genpd;
+	const struct sc7730_pd_data *data;
+	struct sc7730_pds *pds;
+};
+
+struct sc7730_pds {
+	void __iomem *pmu, *aon, *gpu_apb, *analog_status;
+	const struct sc7730_gpu_src *gpu_src;	/* voted while the domain is on */
+	struct device *dev;
+	struct sc7730_pd pd[SC7730_NR_PDS];
+	struct generic_pm_domain *domains[SC7730_NR_PDS];
+	struct genpd_onecell_data onecell;
+};
+
+/* EB0 is also written directly by other bring-up glue */
+static DEFINE_SPINLOCK(sc7730_pd_lock);
+
+static void sc7730_pd_rmw(void __iomem *reg, u32 clr, u32 set)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&sc7730_pd_lock, flags);
+	writel((readl(reg) & ~clr) | set, reg);
+	spin_unlock_irqrestore(&sc7730_pd_lock, flags);
+}
+
+/* Vote for the PLL behind gpu_khz and return the mux setting to use */
+static u32 sc7730_gpu_clk_sel(struct sc7730_pds *pds)
+{
+	const struct sc7730_gpu_src *src = NULL;
+	unsigned int khz = READ_ONCE(gpu_khz);
+	u32 v;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(sc7730_gpu_srcs); i++)
+		if (sc7730_gpu_srcs[i].khz == khz)
+			src = &sc7730_gpu_srcs[i];
+	if (!src || !pds->analog_status)
+		return GPU_CLK_SEL_384M;
+
+	sc7730_pd_rmw(pds->pmu + src->rel_cfg, 0, PLL_AP_SEL);
+	if (readl_poll_timeout_atomic(pds->analog_status, v, !(v & src->pd_bit),
+				      10, 2000)) {
+		sc7730_pd_rmw(pds->pmu + src->rel_cfg, PLL_AP_SEL, 0);
+		dev_warn_once(pds->dev, "PLL for %u kHz does not start, GPU at 384 MHz\n",
+			      khz);
+		return GPU_CLK_SEL_384M;
+	}
+	pds->gpu_src = src;
+	return src->sel;
+}
+
+static int sc7730_pd_power_on(struct generic_pm_domain *genpd)
+{
+	struct sc7730_pd *pd = container_of(genpd, struct sc7730_pd, genpd);
+	struct sc7730_pds *pds = pd->pds;
+	const struct sc7730_pd_data *d = pd->data;
+	u32 v;
+	int ret;
+
+	sc7730_pd_rmw(pds->pmu + d->cfg,
+		      PD_FORCE_SHUTDOWN | PD_AUTO_SHUTDOWN | PD_DELAYS_MASK,
+		      PD_DELAYS);
+	ret = readl_poll_timeout_atomic(pds->pmu + PWR_STATUS0_DBG, v,
+					!((v >> d->state_shift) & 0xf),
+					50, 100000);
+	if (ret) {
+		dev_err(pds->dev, "%s domain does not power up (status %08x)\n",
+			d->name, v);
+		return ret;
+	}
+	udelay(100);
+	sc7730_pd_rmw(pds->aon + AON_APB_EB0, 0, d->eb);
+
+	if (d == &sc7730_pd_data[SC7730_PD_GPU] && pds->gpu_apb)
+		writel(FIELD_PREP(GPU_CLK_SEL, sc7730_gpu_clk_sel(pds)) |
+		       FIELD_PREP(GPU_CLK_DIV, 0),
+		       pds->gpu_apb + GPU_APB_CLK_CTRL);
+	return 0;
+}
+
+static int sc7730_pd_power_off(struct generic_pm_domain *genpd)
+{
+	struct sc7730_pd *pd = container_of(genpd, struct sc7730_pd, genpd);
+	struct sc7730_pds *pds = pd->pds;
+	const struct sc7730_pd_data *d = pd->data;
+
+	sc7730_pd_rmw(pds->aon + AON_APB_EB0, d->eb, 0);
+	sc7730_pd_rmw(pds->pmu + d->cfg, 0, PD_FORCE_SHUTDOWN);
+
+	/* the GPU is the only AP user of the modem PLLs */
+	if (d == &sc7730_pd_data[SC7730_PD_GPU] && pds->gpu_src) {
+		sc7730_pd_rmw(pds->pmu + pds->gpu_src->rel_cfg, PLL_AP_SEL, 0);
+		pds->gpu_src = NULL;
+	}
+	return 0;
+}
+
+static int sc7730_pds_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sc7730_pds *pds;
+	struct resource *res;
+	int i, ret;
+
+	pds = devm_kzalloc(dev, sizeof(*pds), GFP_KERNEL);
+	if (!pds)
+		return -ENOMEM;
+	pds->dev = dev;
+
+	/* both register blocks are shared with other glue: no request */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "pmu");
+	if (res)
+		pds->pmu = devm_ioremap(dev, res->start, resource_size(res));
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "aon-apb");
+	if (res)
+		pds->aon = devm_ioremap(dev, res->start, resource_size(res));
+	if (!pds->pmu || !pds->aon)
+		return -ENOMEM;
+	/* only touched while the GPU domain is on */
+	pds->gpu_apb = devm_ioremap(dev, GPU_APB_PHYS, 0x10);
+	pds->analog_status = devm_ioremap(dev, ANALOG_STATUS_PHYS, 4);
+
+	for (i = 0; i < SC7730_NR_PDS; i++) {
+		struct sc7730_pd *pd = &pds->pd[i];
+		u32 st = readl(pds->pmu + PWR_STATUS0_DBG);
+		bool off;
+
+		pd->data = &sc7730_pd_data[i];
+		pd->pds = pds;
+		pd->genpd.name = pd->data->name;
+		pd->genpd.power_on = sc7730_pd_power_on;
+		pd->genpd.power_off = sc7730_pd_power_off;
+		/*
+		 * Off unless the bootloader left it on; genpd switches unused
+		 * domains off late in boot.
+		 */
+		off = (st >> pd->data->state_shift) & 0xf;
+		ret = pm_genpd_init(&pd->genpd, NULL, off);
+		if (ret)
+			return ret;
+		pds->domains[i] = &pd->genpd;
+		dev_info(dev, "%s domain %s at boot\n", pd->data->name,
+			 off ? "off" : "on");
+	}
+
+	pds->onecell.domains = pds->domains;
+	pds->onecell.num_domains = SC7730_NR_PDS;
+	return of_genpd_add_provider_onecell(dev->of_node, &pds->onecell);
+}
+
+static const struct of_device_id sc7730_pds_of_match[] = {
+	{ .compatible = "sprd,sc7730-pmu-domains" },
+	{ }
+};
+
+static struct platform_driver sc7730_pds_driver = {
+	.probe = sc7730_pds_probe,
+	.driver = {
+		.name = "sc7730-pmu-domains",
+		.of_match_table = sc7730_pds_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(sc7730_pds_driver);
diff --git a/arch/arm/mach-sprd/restart.c b/arch/arm/mach-sprd/restart.c
new file mode 100644
index 000000000..7449990d3
--- /dev/null
+++ b/arch/arm/mach-sprd/restart.c
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Restart the SC7730 through the SC2723 PMIC watchdog, the way the Samsung
+ * vendor kernel does it (arch_reset() + sec-reboot.c + sec_debug.c):
+ *
+ *   - clear Samsung's upload magic; the vendor kernel arms it at boot and
+ *     only clears it on a clean reboot
+ *   - INFORM2 = "no low-power charging", INFORM3 = reboot reason; sboot's
+ *     sprd_check_reboot_mode() takes (INFORM3 & 0xf) as the boot mode when
+ *     INFORM3 & ~0xf == 0x12345670 (4 = recovery)
+ *   - PMIC POR_RST_MONITOR = Spreadtrum boot mode, as the vendor does
+ *     (sboot ignores it)
+ *   - start the PMIC watchdog with 50 ms and wait for it
+ *
+ * The vendor header puts the magic at 0x50003000, which holds code on
+ * this board. Disassembling SBOOT (loaded at 0x9f600000) shows sboot
+ * reading the magic at 0xf80 and INFORM3 at 0xf90 in IRAM0 instead.
+ * The IRAM is only touched when restarting, never at boot.
+ *
+ * Power off: without a handler the ARM core code falls back to
+ * machine_halt() (CPUs spin with IRQs off, the SoC stays powered, the
+ * power key is dead until a PMIC key-combo reset). sprd_power_off() cuts
+ * the PMIC rails like the vendor sc8830_power_off() in pm-scx35.c.
+ */
+
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/notifier.h>
+#include <linux/of.h>
+#include <linux/printk.h>
+#include <linux/reboot.h>
+#include <linux/string.h>
+
+#include "adi.h"
+
+#define SEC_DEBUG_PHYS		0x00000f80	/* IRAM0, see above */
+#define SEC_UPLOAD_MAGIC	0x00
+#define SEC_INFORM2		0x0c
+#define SEC_INFORM3		0x10
+#define SEC_NO_LPM		0x12345678
+#define SEC_MODE(m)		(0x12345670 | (m))
+#define SEC_MODE_NONE		0
+#define SEC_MODE_DOWNLOAD	1
+#define SEC_MODE_RECOVERY	4
+
+#define GLB_ARM_MODULE_EN	SC2723_GLB(0x000)
+#define GLB_RTC_CLK_EN		SC2723_GLB(0x008)
+#define GLB_POR_RST_MONITOR	SC2723_GLB(0x124)
+#define GLB_WDG_EN		BIT(2)		/* in both enable registers */
+
+#define HWRST_RECOVERY		0x20
+#define HWRST_NORMAL		0x40
+#define HWRST_SPECIAL		0x70
+
+#define GLB_LDO_DCDC_PD		SC2723_GLB(0x010)	/* 1 = rail off */
+#define GLB_LDO_PD_CTRL		SC2723_GLB(0x014)	/* 1 = LDO off */
+#define GLB_POR_SRC_FLAG	SC2723_GLB(0x130)
+#define GLB_PWR_WR_PROT		SC2723_GLB(0x150)
+#define PWR_WR_PROT_KEY		0x6e7f		/* unlocks GLB_LDO_DCDC_PD */
+#define PWR_WR_PROT_OPEN	BIT(15)
+#define LDO_PD_CTRL_ALL		0x0fff
+#define LDO_DCDC_PD_ALL		0x7fff		/* all DCDC/LDO + bandgap */
+
+#define WDG_LOAD_LOW		SC2723_WDG(0x00)
+#define WDG_LOAD_HIGH		SC2723_WDG(0x04)
+#define WDG_CTRL		SC2723_WDG(0x08)
+#define WDG_CNT_EN		BIT(1)
+#define WDG_NEW_VER_EN		BIT(2)
+#define WDG_RST_EN		BIT(3)
+#define WDG_INT_RAW		SC2723_WDG(0x10)
+#define WDG_LD_BUSY		BIT(4)
+#define WDG_LOCK		SC2723_WDG(0x20)
+#define WDG_UNLOCK_KEY		0xe551
+#define WDG_TICKS_50MS		(32768 * 50 / 1000)
+
+static void __iomem *sec_debug;
+
+static int sprd_restart(struct notifier_block *nb, unsigned long mode,
+			void *data)
+{
+	const char *cmd = data;
+	u32 hwrst = HWRST_SPECIAL, sec = SEC_MODE_NONE, v;
+	int i;
+
+	if (cmd && !strcmp(cmd, "recovery")) {
+		hwrst = HWRST_RECOVERY;
+		sec = SEC_MODE_RECOVERY;
+	} else if (cmd && !strcmp(cmd, "download")) {
+		hwrst = HWRST_NORMAL;
+		sec = SEC_MODE_DOWNLOAD;
+	} else if (cmd) {
+		hwrst = HWRST_NORMAL;
+	}
+	pr_emerg("sprd-restart: cmd %s, upload magic was %08x\n",
+		 cmd ?: "(none)", sec_debug ? readl(sec_debug) : 0);
+
+	if (sec_debug) {
+		writel(0, sec_debug + SEC_UPLOAD_MAGIC);
+		writel(SEC_NO_LPM, sec_debug + SEC_INFORM2);
+		writel(SEC_MODE(sec), sec_debug + SEC_INFORM3);
+	}
+	sprd_adi_write(GLB_POR_RST_MONITOR, hwrst);
+
+	sprd_adi_update(GLB_ARM_MODULE_EN, 0, GLB_WDG_EN);
+	sprd_adi_update(GLB_RTC_CLK_EN, 0, GLB_WDG_EN);
+	sprd_adi_write(WDG_LOCK, WDG_UNLOCK_KEY);
+	sprd_adi_update(WDG_CTRL, 0, WDG_NEW_VER_EN);
+	sprd_adi_write(WDG_LOAD_HIGH, WDG_TICKS_50MS >> 16);
+	sprd_adi_write(WDG_LOAD_LOW, WDG_TICKS_50MS & 0xffff);
+	for (i = 0; i < 10000; i++)
+		if (sprd_adi_read(WDG_INT_RAW, &v) || !(v & WDG_LD_BUSY))
+			break;
+	sprd_adi_update(WDG_CTRL, 0, WDG_CNT_EN | WDG_RST_EN);
+	sprd_adi_write(WDG_LOCK, ~WDG_UNLOCK_KEY & 0xffff);
+
+	mdelay(1000);
+	pr_emerg("sprd-restart: PMIC watchdog did not reset the system\n");
+	return NOTIFY_DONE;
+}
+
+/*
+ * Vendor sequence (arch/arm/mach-sc/pm-scx35.c, sc8830_power_off()):
+ * LDO_PD_CTRL = 0x1fff, unlock with 0x6e7f and wait for BIT(15), then
+ * LDO_PD_CTRL = 0xfff and LDO_DCDC_PD = 0x7fff. The PMIC keeps its RTC and
+ * power-key logic on VBAT, so the key (or a charger event) powers it up
+ * again. IRAM0 content (INFORM2/3) does not survive, so sboot decides
+ * between normal boot and low-power charging from the PMIC power-on source.
+ */
+static void sprd_power_off(void)
+{
+	u32 v = 0;
+	int i;
+
+	sprd_adi_read(GLB_POR_SRC_FLAG, &v);
+	pr_emerg("sprd-poweroff: POR source flags %04x, cutting power\n", v);
+
+	sprd_adi_write(GLB_LDO_PD_CTRL, 0x1fff);
+	sprd_adi_write(GLB_PWR_WR_PROT, PWR_WR_PROT_KEY);
+	for (i = 0; i < 10000; i++)
+		if (sprd_adi_read(GLB_PWR_WR_PROT, &v) || (v & PWR_WR_PROT_OPEN))
+			break;
+	sprd_adi_write(GLB_LDO_PD_CTRL, LDO_PD_CTRL_ALL);
+	sprd_adi_write(GLB_LDO_DCDC_PD, LDO_DCDC_PD_ALL);
+
+	mdelay(3000);
+	pr_emerg("sprd-poweroff: PMIC is still alive, restarting instead\n");
+	emergency_restart();
+}
+
+static struct notifier_block sprd_restart_nb = {
+	.notifier_call = sprd_restart,
+	.priority = 128,
+};
+
+static int __init sprd_restart_init(void)
+{
+	if (!of_machine_is_compatible("sprd,sc7730"))
+		return 0;
+	sec_debug = ioremap(SEC_DEBUG_PHYS, 0x20);
+	register_platform_power_off(sprd_power_off);
+	return register_restart_handler(&sprd_restart_nb);
+}
+arch_initcall(sprd_restart_init);
diff --git a/arch/arm/mach-sprd/sc2723-adc.c b/arch/arm/mach-sprd/sc2723-adc.c
new file mode 100644
index 000000000..8c8e62e4c
--- /dev/null
+++ b/arch/arm/mach-sprd/sc2723-adc.c
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Auxiliary ADC of the SC2723 PMIC as an IIO device, raw counts only.
+ *
+ * One software conversion at a time, as the vendor 3.10 kernel does it
+ * (arch/arm/mach-sc/adc.c): select the input in SW_CH_CFG (small scale,
+ * quick mode, resistance path), start a single 12-bit sample with
+ * SW_CH_ON and wait for the raw interrupt status. On the gtelwifi the
+ * battery thermistor is channel 1. The vendor kernel shares the block
+ * with the modem CPU under a hardware spinlock; nothing else uses it here.
+ *
+ * Bring-up glue on top of the ADI helpers, like the other SC2723 drivers
+ * in this directory, until mainline sc27xx_adc knows the SC2723 (other
+ * global register offsets, scale in bit 5 instead of bits 10:9).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/iio/iio.h>
+#include <linux/mod_devicetable.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+
+#include "adi.h"
+
+#define SC2723_ADC(x)		(0x300 + (x))
+#define ADC_CTL			SC2723_ADC(0x00)
+#define ADC_CTL_EN		BIT(0)
+#define ADC_CTL_SW_CH_ON	BIT(1)
+#define ADC_CTL_12BIT		BIT(2)
+#define ADC_CTL_RUN_NUM		GENMASK(7, 4)	/* samples - 1 */
+#define ADC_SW_CH_CFG		SC2723_ADC(0x04)
+#define ADC_CH_ID		GENMASK(4, 0)
+#define ADC_DAT			SC2723_ADC(0x4c)
+#define ADC_IRQ_CLR		SC2723_ADC(0x54)
+#define ADC_IRQ_RAW		SC2723_ADC(0x5c)
+
+#define GLB_ARM_MODULE_EN	SC2723_GLB(0x000)
+#define GLB_ADC_EN		BIT(6)
+#define GLB_ARM_CLK_EN		SC2723_GLB(0x004)
+#define GLB_CLK_AUXADC_EN	(BIT(9) | BIT(8))
+#define GLB_XTL_WAIT_CTRL	SC2723_GLB(0x0e8)
+#define GLB_XTL_EN		BIT(8)
+
+#define SC2723_ADC_CHANNELS	32
+
+struct sc2723_adc {
+	struct mutex lock;	/* one conversion at a time */
+};
+
+static int sc2723_adc_convert(struct sc2723_adc *adc, int channel, int *raw)
+{
+	u32 ctl, val = 0;
+	int i, ret;
+
+	mutex_lock(&adc->lock);
+	ret = sprd_adi_write(ADC_SW_CH_CFG, FIELD_PREP(ADC_CH_ID, channel));
+	if (!ret)
+		ret = sprd_adi_read(ADC_CTL, &ctl);
+	if (ret)
+		goto out;
+
+	ctl &= ~(ADC_CTL_EN | ADC_CTL_SW_CH_ON | ADC_CTL_12BIT | ADC_CTL_RUN_NUM);
+	sprd_adi_write(ADC_CTL, ctl);
+	sprd_adi_write(ADC_IRQ_CLR, 1);
+	sprd_adi_write(ADC_CTL, ctl | ADC_CTL_EN | ADC_CTL_12BIT |
+		       ADC_CTL_SW_CH_ON);
+
+	/* the vendor waits up to 600 us */
+	for (i = 0; i < 20; i++) {
+		ret = sprd_adi_read(ADC_IRQ_RAW, &val);
+		if (ret || val)
+			break;
+		usleep_range(50, 100);
+	}
+	if (!ret && !val)
+		ret = -ETIMEDOUT;
+	if (!ret)
+		ret = sprd_adi_read(ADC_DAT, &val);
+	if (!ret)
+		*raw = val & 0xfff;
+	sprd_adi_write(ADC_CTL, ctl);
+out:
+	mutex_unlock(&adc->lock);
+	return ret;
+}
+
+static int sc2723_adc_read_raw(struct iio_dev *indio_dev,
+			       struct iio_chan_spec const *chan,
+			       int *val, int *val2, long mask)
+{
+	int ret;
+
+	if (mask != IIO_CHAN_INFO_RAW)
+		return -EINVAL;
+	ret = sc2723_adc_convert(iio_priv(indio_dev), chan->channel, val);
+	return ret ?: IIO_VAL_INT;
+}
+
+static const struct iio_info sc2723_adc_info = {
+	.read_raw = sc2723_adc_read_raw,
+};
+
+static int sc2723_adc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct iio_chan_spec *chans;
+	struct iio_dev *indio_dev;
+	struct sc2723_adc *adc;
+	int i, ret;
+
+	indio_dev = devm_iio_device_alloc(dev, sizeof(*adc));
+	if (!indio_dev)
+		return -ENOMEM;
+	adc = iio_priv(indio_dev);
+	ret = devm_mutex_init(dev, &adc->lock);
+	if (ret)
+		return ret;
+
+	chans = devm_kcalloc(dev, SC2723_ADC_CHANNELS, sizeof(*chans),
+			     GFP_KERNEL);
+	if (!chans)
+		return -ENOMEM;
+	for (i = 0; i < SC2723_ADC_CHANNELS; i++) {
+		chans[i].type = IIO_VOLTAGE;
+		chans[i].indexed = 1;
+		chans[i].channel = i;
+		chans[i].info_mask_separate = BIT(IIO_CHAN_INFO_RAW);
+	}
+
+	/* module, its clocks and the crystal it samples with */
+	ret = sprd_adi_update(GLB_ARM_MODULE_EN, 0, GLB_ADC_EN);
+	if (!ret)
+		ret = sprd_adi_update(GLB_ARM_CLK_EN, 0, GLB_CLK_AUXADC_EN);
+	if (!ret)
+		ret = sprd_adi_update(GLB_XTL_WAIT_CTRL, 0, GLB_XTL_EN);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot enable the ADC\n");
+
+	indio_dev->name = "sc2723-adc";
+	indio_dev->info = &sc2723_adc_info;
+	indio_dev->modes = INDIO_DIRECT_MODE;
+	indio_dev->channels = chans;
+	indio_dev->num_channels = SC2723_ADC_CHANNELS;
+	return devm_iio_device_register(dev, indio_dev);
+}
+
+static const struct of_device_id sc2723_adc_of_match[] = {
+	{ .compatible = "sprd,sc2723-adc-polled" },
+	{ }
+};
+
+static struct platform_driver sc2723_adc_driver = {
+	.probe = sc2723_adc_probe,
+	.driver = {
+		.name = "sc2723-adc-polled",
+		.of_match_table = sc2723_adc_of_match,
+	},
+};
+builtin_platform_driver(sc2723_adc_driver);
diff --git a/arch/arm/mach-sprd/sc2723-dcdc-arm.c b/arch/arm/mach-sprd/sc2723-dcdc-arm.c
new file mode 100644
index 000000000..96bfd7819
--- /dev/null
+++ b/arch/arm/mach-sprd/sc2723-dcdc-arm.c
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DCDC_ARM of the SC2723 PMIC, the Cortex-A7 cluster supply ("vddarm"),
+ * as a regulator for CPU frequency scaling.
+ *
+ * DCDC_ARM_ADI (0xA04) holds the voltage. With MIXED_CTRL0 (0x918) bit 14
+ * clear, which the SPL and sboot assume, bits 7:5 pick a base voltage and
+ * bits 4:0 add 3.125 mV steps on top (vendor sc2723-regulator_dt.c,
+ * "non-linear" mode). Selectors here are linear from 650 mV in 3.125 mV
+ * steps and get mapped onto base + trim. The linear mode (bit 14 set)
+ * would put very different voltages on the same register values, so the
+ * driver refuses to probe then.
+ *
+ * Like the vendor driver it moves in 25 mV steps against overshoot,
+ * waiting 5 us per step when rising (10 us per 50 mV) and not at all when
+ * falling. Doing that here rather than with the core's max_uV_step keeps
+ * the core from asking for a stepped minimum above the target maximum
+ * when it lowers the voltage, which failed with -EWOULDBLOCK.
+ *
+ * The rail is never switched: DCDC_ARM_PD (0x810 bit 10) and the OTP/SW
+ * select bit (0x8C0 bit 2) are left alone. The vendor kernel also writes
+ * 0xA04 with that select bit clear, and the rail follows (measured).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+#include <linux/mod_devicetable.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#include "adi.h"
+
+#define DCDC_ARM_ADI		0xa04
+#define  DCDC_ARM_CTL		GENMASK(7, 5)
+#define  DCDC_ARM_CAL		GENMASK(4, 0)
+#define  DCDC_ARM_RSV		GENMASK(9, 8)
+#define MIXED_CTRL0		0x918
+#define  DCDC_V_CTRL_MODE	BIT(14)
+
+#define DCDC_MIN_UV		650000
+#define DCDC_STEP_UV		3125
+#define DCDC_N_VOLTAGES		240	/* up to 1396.875 mV */
+#define DCDC_STEP_MAX_UV	25000
+#define DCDC_RISE_STEP_US	5
+
+/* CTL index -> base voltage in mV (vendor dcdc_vol_select[]) */
+static const u16 sc2723_dcdc_base[8] = {
+	1100, 700, 800, 900, 1000, 650, 1200, 1300,
+};
+
+static int sc2723_dcdc_read_uv(u32 *uv)
+{
+	u32 val;
+	int ret;
+
+	ret = sprd_adi_read(DCDC_ARM_ADI, &val);
+	if (ret)
+		return ret;
+
+	*uv = sc2723_dcdc_base[FIELD_GET(DCDC_ARM_CTL, val)] * 1000 +
+	      FIELD_GET(DCDC_ARM_CAL, val) * DCDC_STEP_UV;
+	return 0;
+}
+
+static int sc2723_dcdc_get_voltage_sel(struct regulator_dev *rdev)
+{
+	u32 uv;
+	int ret;
+
+	ret = sc2723_dcdc_read_uv(&uv);
+	return ret ?: (int)((uv - DCDC_MIN_UV) / DCDC_STEP_UV);
+}
+
+/* the highest base at or below the target, within the 31 trim steps */
+static int sc2723_dcdc_write_uv(u32 uv)
+{
+	u32 best = 0, trim;
+	int i, idx = -1;
+
+	for (i = 0; i < ARRAY_SIZE(sc2723_dcdc_base); i++) {
+		u32 base = sc2723_dcdc_base[i] * 1000;
+
+		if (base <= uv && base >= best) {
+			best = base;
+			idx = i;
+		}
+	}
+	trim = (uv - best) / DCDC_STEP_UV;
+	if (idx < 0 || trim > FIELD_MAX(DCDC_ARM_CAL))
+		return -EINVAL;
+
+	return sprd_adi_update(DCDC_ARM_ADI, DCDC_ARM_CTL | DCDC_ARM_CAL,
+			       FIELD_PREP(DCDC_ARM_CTL, idx) |
+			       FIELD_PREP(DCDC_ARM_CAL, trim));
+}
+
+static int sc2723_dcdc_set_voltage_sel(struct regulator_dev *rdev,
+				       unsigned int sel)
+{
+	u32 target = DCDC_MIN_UV + sel * DCDC_STEP_UV, uv;
+	int ret;
+
+	ret = sc2723_dcdc_read_uv(&uv);
+	while (!ret && uv != target) {
+		if (target > uv) {
+			uv = min(uv + DCDC_STEP_MAX_UV, target);
+			ret = sc2723_dcdc_write_uv(uv);
+			udelay(DCDC_RISE_STEP_US);
+		} else {
+			uv = max(uv - DCDC_STEP_MAX_UV, target);
+			ret = sc2723_dcdc_write_uv(uv);
+		}
+	}
+	return ret;
+}
+
+static const struct regulator_ops sc2723_dcdc_ops = {
+	.list_voltage = regulator_list_voltage_linear,
+	.map_voltage = regulator_map_voltage_linear,
+	.get_voltage_sel = sc2723_dcdc_get_voltage_sel,
+	.set_voltage_sel = sc2723_dcdc_set_voltage_sel,
+};
+
+static const struct regulator_desc sc2723_dcdc_desc = {
+	.name = "vddarm",
+	.type = REGULATOR_VOLTAGE,
+	.owner = THIS_MODULE,
+	.ops = &sc2723_dcdc_ops,
+	.min_uV = DCDC_MIN_UV,
+	.uV_step = DCDC_STEP_UV,
+	.n_voltages = DCDC_N_VOLTAGES,
+};
+
+static int sc2723_dcdc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct regulator_config cfg = {};
+	struct regulator_dev *rdev;
+	u32 mode, val;
+	int ret;
+
+	ret = sprd_adi_read(MIXED_CTRL0, &mode);
+	if (!ret)
+		ret = sprd_adi_read(DCDC_ARM_ADI, &val);
+	if (ret)
+		return ret;
+	if (mode & DCDC_V_CTRL_MODE)
+		return dev_err_probe(dev, -ENODEV,
+				     "linear voltage mode, not supported\n");
+	if (val & DCDC_ARM_RSV)
+		return dev_err_probe(dev, -ENODEV,
+				     "unexpected DCDC_ARM_ADI %#x\n", val);
+
+	cfg.dev = dev;
+	cfg.of_node = dev->of_node;
+	cfg.init_data = of_get_regulator_init_data(dev, dev->of_node,
+						   &sc2723_dcdc_desc);
+	if (!cfg.init_data)
+		return -ENOMEM;
+
+	rdev = devm_regulator_register(dev, &sc2723_dcdc_desc, &cfg);
+	return PTR_ERR_OR_ZERO(rdev);
+}
+
+static const struct of_device_id sc2723_dcdc_of_match[] = {
+	{ .compatible = "sprd,sc2723-dcdc-arm" },
+	{ }
+};
+
+static struct platform_driver sc2723_dcdc_driver = {
+	.probe = sc2723_dcdc_probe,
+	.driver = {
+		.name = "sc2723-dcdc-arm",
+		.of_match_table = sc2723_dcdc_of_match,
+	},
+};
+builtin_platform_driver(sc2723_dcdc_driver);
diff --git a/arch/arm/mach-sprd/sc2723-fgu.c b/arch/arm/mach-sprd/sc2723-fgu.c
new file mode 100644
index 000000000..e07986ed6
--- /dev/null
+++ b/arch/arm/mach-sprd/sc2723-fgu.c
@@ -0,0 +1,680 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Fuel gauge (FGU) of the SC2723 PMIC as a battery power supply, polled.
+ *
+ * The bootloader switches the FGU on at every boot; this driver only reads
+ * it: battery voltage (VOLT_VAL), current through the 20 mOhm sense resistor
+ * (CURT_VAL, 8192 = 0 A, positive = charging) and the coulomb counter, which
+ * integrates CURT - 8192 at 2 Hz. The ADC scale comes from two calibration
+ * points (4.2 V and 3.6 V) in the PMIC's A-die eFuse. State of charge is
+ * coulomb counting from an OCV estimate (V - I * R_int) at probe, with the
+ * vendor's re-anchoring at the top and bottom of the OCV table and when the
+ * charger reports the battery full. Like the vendor, the capacity is kept
+ * in the FGU's always-on USER_AREA, so a reboot continues from it instead
+ * of a fresh estimate under load.
+ *
+ * The battery thermistor is not wired to the charger but to the PMIC's
+ * auxiliary ADC. With an ADC channel and the vendor's table this reports
+ * the temperature and, like the vendor's sec-battery, stops charging
+ * outside a temperature window through the charger's charge_behaviour.
+ *
+ * Register layout, eFuse decoding and formulas from the vendor 3.10 driver
+ * (drivers/battery/sprd_2713_fgu.c, drivers/misc/sprd_otp/). Mainline
+ * sc27xx_fuel_gauge has the same FGU block but needs a regmap parent, IIO
+ * channels and an nvmem cell that do not exist for the SC2723 yet; this is
+ * bring-up glue on top of the ADI helpers until they do.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/iio/consumer.h>
+#include <linux/math64.h>
+#include <linux/mod_devicetable.h>
+#include <linux/moduleparam.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/workqueue.h>
+
+#include "adi.h"
+
+#define GLB_ARM_MODULE_EN	SC2723_GLB(0x000)
+#define GLB_FGU_EN		BIT(8)
+#define GLB_EFS_EN		BIT(7)
+#define GLB_RTC_CLK_EN		SC2723_GLB(0x008)
+#define GLB_RTC_FGU_EN		(BIT(7) | BIT(6))
+
+#define EFUSE(x)		(0x200 + (x))
+#define EFUSE_DATA_RD		EFUSE(0x04)
+#define EFUSE_BLOCK_INDEX	EFUSE(0x0c)
+#define EFUSE_MODE_CTRL		EFUSE(0x10)
+#define EFUSE_RD_START		BIT(1)	/* bit 0 starts programming: never */
+#define EFUSE_STATUS		EFUSE(0x14)
+#define EFUSE_READ_BUSY		BIT(1)
+
+#define FGU(x)			(0x500 + (x))
+#define FGU_VOLT_VAL		FGU(0x20)
+#define FGU_CURT_VAL		FGU(0x2c)
+#define FGU_CLBCNT_VALH		FGU(0x68)
+#define FGU_CLBCNT_VALL		FGU(0x6c)
+#define FGU_USER_AREA_SET	FGU(0xa0)
+#define FGU_USER_AREA_CLEAR	FGU(0xa4)
+#define FGU_USER_AREA		FGU(0xa8)
+#define USER_AREA_SOC		GENMASK(11, 0)
+#define USER_AREA_TYPE		GENMASK(15, 12)
+#define USER_AREA_TYPE_NORMAL	0x5	/* 0xf after a battery disconnect */
+
+#define FGU_CURT_ZERO		8192
+#define FGU_POLL_MS		30000
+/*
+ * A saved capacity this far from the OCV estimate is stale. The OCV curve
+ * is flat in the middle, where the estimate under load is rough, but steep
+ * near full and empty, where the estimate wins over a value saved before
+ * the battery charged without us (powered off or hung).
+ */
+#define FGU_SAVED_MAX_DIFF	25
+#define FGU_SAVED_MAX_DIFF_EDGE	10
+#define FGU_EDGE_SOC		10	/* below this or above 100 minus it */
+
+/*
+ * Empty is decided by the OCV (V - I * R_int), not by the loaded voltage:
+ * a worn cell sags under a burst while still holding charge. It must hold
+ * for FGU_ZERO_POLLS polls in a row under a moderate load.
+ */
+#define FGU_ZERO_POLLS		2
+#define FGU_ZERO_MAX_UA		600000
+
+static bool trace;
+module_param(trace, bool, 0644);
+MODULE_PARM_DESC(trace, "log voltage, current, OCV and the SOC estimates on every poll");
+
+/* without eFuse data (vendor defaults): ADC counts at 4.2 V and 3.6 V */
+#define FGU_DEF_A42		2752
+#define FGU_DEF_A36		2374
+
+struct sc2723_fgu {
+	struct device *dev;
+	struct power_supply *psy;
+	struct power_supply_battery_info *info;
+	struct delayed_work work;
+	int vol_1000mv_adc, vol_offset, cur_1000ma_adc;
+	int rint_mohm;
+	int soc0;		/* capacity at the last anchor, % */
+	s32 cc0;		/* coulomb counter at the last anchor */
+	int soc;		/* last reported capacity, % */
+	int zero_cnt;		/* polls in a row with the OCV below minimum */
+	int status;
+	bool ready;		/* battery data loaded, polling may run */
+	struct iio_channel *temp_chan;
+	u32 *temp_table;	/* pairs: ADC counts rising, 0.1 C falling */
+	int temp_points;
+	int temp;		/* 0.1 C */
+	bool temp_limits;
+	int stop_lo, stop_hi, resume_lo, resume_hi;	/* 0.1 C */
+	bool inhibited;		/* charging stopped for the temperature */
+};
+
+static int fgu_read(u32 reg)
+{
+	u32 val;
+
+	return sprd_adi_read(reg, &val) ?: (int)val;
+}
+
+static int sc2723_efuse_read(int block)
+{
+	u32 val;
+	int i, ret;
+
+	ret = sprd_adi_update(GLB_ARM_MODULE_EN, 0, GLB_EFS_EN);
+	if (ret)
+		return ret;
+	sprd_adi_write(EFUSE_BLOCK_INDEX, block & 0x1f);
+	sprd_adi_write(EFUSE_MODE_CTRL, EFUSE_RD_START);
+	for (i = 0; i < 1000; i++) {
+		ret = sprd_adi_read(EFUSE_STATUS, &val);
+		if (ret || !(val & EFUSE_READ_BUSY))
+			break;
+		udelay(10);
+	}
+	if (!ret && i == 1000)
+		ret = -ETIMEDOUT;
+	if (!ret)
+		ret = sprd_adi_read(EFUSE_DATA_RD, &val);
+	sprd_adi_update(GLB_ARM_MODULE_EN, GLB_EFS_EN, 0);
+
+	/* the blocks read back inverted */
+	return ret ?: (int)(~val & 0xff);
+}
+
+/* Two calibration points from the eFuse, as the vendor's otp-helper.c */
+static void sc2723_fgu_calibrate(struct sc2723_fgu *fgu, u32 r_real_uohm)
+{
+	int a42 = FGU_DEF_A42, a36 = FGU_DEF_A36, blk[4], i;
+	static const int blocks[] = { 0, 12, 13, 14 };
+	const char *src = "defaults";
+	u32 bits;
+
+	for (i = 0; i < ARRAY_SIZE(blocks); i++)
+		blk[i] = sc2723_efuse_read(blocks[i]);
+
+	if (blk[0] >= 0 && blk[1] >= 0 && blk[2] >= 0 && blk[3] >= 0 &&
+	    !(blk[0] & BIT(7))) {
+		/* blocks 12..14 as one little-endian bit string */
+		bits = blk[1] | blk[2] << 8 | blk[3] << 16;
+		a42 = (bits & 0x1ff) + 6963 - 4096 - 256;
+		a36 = a42 - 410 - ((bits >> 18) & 0x3f) + 16;
+		src = "eFuse";
+	}
+
+	fgu->vol_1000mv_adc = ((a42 - a36) * 10 + 3) / 6;
+	fgu->vol_offset = -(a42 * 10 - fgu->vol_1000mv_adc * 42) / 10;
+	/* nominal sense resistor 20 mOhm, the board's real one in DT */
+	fgu->cur_1000ma_adc = DIV_ROUND_CLOSEST(fgu->vol_1000mv_adc * 4 *
+						r_real_uohm, 20000);
+
+	dev_info(fgu->dev,
+		 "%s calibration: 4.2 V = %d, 3.6 V = %d (eFuse %02x %02x %02x %02x), %d/V, offset %d, %d/A\n",
+		 src, a42, a36, blk[0], blk[1], blk[2], blk[3],
+		 fgu->vol_1000mv_adc, fgu->vol_offset, fgu->cur_1000ma_adc);
+}
+
+static int fgu_uv(struct sc2723_fgu *fgu, int raw)
+{
+	return div_s64((s64)(raw + fgu->vol_offset) * 1000000,
+		       fgu->vol_1000mv_adc);
+}
+
+static int fgu_ua(struct sc2723_fgu *fgu, int raw)
+{
+	return div_s64((s64)(raw - FGU_CURT_ZERO) * 1000000,
+		       fgu->cur_1000ma_adc);
+}
+
+static int sc2723_fgu_clbcnt(s32 *cc)
+{
+	int h1, l1, h2, l2, i;
+
+	/* read until two snapshots agree, the halves are not latched */
+	for (i = 0; i < 5; i++) {
+		l1 = fgu_read(FGU_CLBCNT_VALL);
+		h1 = fgu_read(FGU_CLBCNT_VALH);
+		l2 = fgu_read(FGU_CLBCNT_VALL);
+		h2 = fgu_read(FGU_CLBCNT_VALH);
+		if (l1 < 0 || h1 < 0 || l2 < 0 || h2 < 0)
+			return -EIO;
+		if (l1 == l2 && h1 == h2) {
+			*cc = (s32)((u32)h1 << 16 | l1);
+			return 0;
+		}
+	}
+	return -EAGAIN;
+}
+
+/* counts to µAh: the counter adds CURT - 8192 twice per second */
+static s64 fgu_cc_to_uah(struct sc2723_fgu *fgu, s32 delta)
+{
+	return div_s64((s64)delta * 10000, 72 * fgu->cur_1000ma_adc);
+}
+
+static int sc2723_fgu_ocv_uv(struct sc2723_fgu *fgu, int uv, int ua)
+{
+	return uv - div_s64((s64)ua * fgu->rint_mohm, 1000);
+}
+
+static void sc2723_fgu_anchor(struct sc2723_fgu *fgu, int soc)
+{
+	s32 cc;
+
+	if (sc2723_fgu_clbcnt(&cc))
+		return;
+	fgu->soc0 = soc;
+	fgu->cc0 = cc;
+}
+
+static void sc2723_fgu_save(int soc)
+{
+	u32 val = FIELD_PREP(USER_AREA_TYPE, USER_AREA_TYPE_NORMAL) |
+		  FIELD_PREP(USER_AREA_SOC, soc);
+
+	/* set/clear pair like the vendor; the status register reads back */
+	sprd_adi_write(FGU_USER_AREA_CLEAR, ~val & (USER_AREA_TYPE | USER_AREA_SOC));
+	sprd_adi_write(FGU_USER_AREA_SET, val);
+}
+
+static bool sc2723_fgu_charger_full(struct sc2723_fgu *fgu)
+{
+	union power_supply_propval val;
+
+	return !power_supply_get_property_from_supplier(fgu->psy,
+				POWER_SUPPLY_PROP_STATUS, &val) &&
+	       val.intval == POWER_SUPPLY_STATUS_FULL;
+}
+
+static int sc2723_fgu_read_temp(struct sc2723_fgu *fgu, int *temp)
+{
+	const u32 *t = fgu->temp_table;
+	int raw, i, ret;
+
+	ret = iio_read_channel_raw(fgu->temp_chan, &raw);
+	if (ret < 0)
+		return ret;
+
+	/* linear between the points, clamped at the ends */
+	if (raw <= t[0]) {
+		*temp = (s32)t[1];
+		return 0;
+	}
+	for (i = 1; i < fgu->temp_points; i++) {
+		int r0 = t[2 * i - 2], r1 = t[2 * i];
+		int c0 = (s32)t[2 * i - 1], c1 = (s32)t[2 * i + 1];
+
+		if (raw <= r1) {
+			*temp = c0 + (c1 - c0) * (raw - r0) / (r1 - r0);
+			return 0;
+		}
+	}
+	*temp = (s32)t[2 * fgu->temp_points - 1];
+	return 0;
+}
+
+static void sc2723_fgu_temp_limits(struct sc2723_fgu *fgu, int temp)
+{
+	union power_supply_propval val;
+	struct power_supply *charger;
+	bool inhibit = fgu->inhibited;
+
+	if (temp <= fgu->stop_lo || temp >= fgu->stop_hi)
+		inhibit = true;
+	else if (temp >= fgu->resume_lo && temp <= fgu->resume_hi)
+		inhibit = false;
+	if (inhibit == fgu->inhibited)
+		return;
+
+	charger = power_supply_get_by_reference(dev_fwnode(fgu->dev),
+						"power-supplies");
+	if (IS_ERR_OR_NULL(charger))
+		return;
+	val.intval = inhibit ? POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE :
+			       POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
+	if (!power_supply_set_property(charger,
+				       POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR, &val)) {
+		fgu->inhibited = inhibit;
+		dev_warn(fgu->dev, "battery at %d.%d C, charging %s\n",
+			 temp / 10, abs(temp % 10),
+			 inhibit ? "stopped" : "allowed again");
+	}
+	power_supply_put(charger);
+}
+
+static void sc2723_fgu_update(struct sc2723_fgu *fgu)
+{
+	int volt = fgu_read(FGU_VOLT_VAL), curt = fgu_read(FGU_CURT_VAL);
+	int uv, ua, ocv, soc, soc_cc, status, full_uah;
+	bool supplied, full, discharging;
+	s32 cc, delta;
+
+	if (volt < 0 || curt < 0 || sc2723_fgu_clbcnt(&cc))
+		return;
+	uv = fgu_uv(fgu, volt & 0x1fff);
+	ua = fgu_ua(fgu, curt & 0x3fff);
+	ocv = sc2723_fgu_ocv_uv(fgu, uv, ua);
+	full_uah = fgu->info->charge_full_design_uah;
+
+	/* the counter may be 30 bit wide: compare modulo 2^30 */
+	delta = sign_extend32(cc - fgu->cc0, 29);
+	soc = fgu->soc0 + div_s64(fgu_cc_to_uah(fgu, delta) * 100, full_uah);
+	soc_cc = soc;
+
+	/*
+	 * Re-anchor like the vendor at the ends of the OCV table and when
+	 * the charger has terminated. After termination the tablet runs
+	 * from the battery until the charger restarts, keep 100 % meanwhile.
+	 */
+	supplied = power_supply_am_i_supplied(fgu->psy) > 0;
+	/*
+	 * smb347 also reads Full when it terminated once and charging is
+	 * now off, which is the case while we inhibit it for the temperature.
+	 */
+	full = supplied && !fgu->inhibited && sc2723_fgu_charger_full(fgu);
+	discharging = !supplied || ua < -20000;
+	if (full || ocv >= fgu->info->constant_charge_voltage_max_uv) {
+		fgu->zero_cnt = 0;
+		soc = 100;
+	} else if (discharging && ocv < fgu->info->voltage_min_design_uv &&
+		   -ua <= FGU_ZERO_MAX_UA) {
+		if (fgu->zero_cnt < FGU_ZERO_POLLS)
+			fgu->zero_cnt++;
+	} else {
+		fgu->zero_cnt = 0;
+	}
+	soc = clamp(soc, 0, 100);
+	if (fgu->zero_cnt >= FGU_ZERO_POLLS) {
+		/* really empty: report 0, anchor at 1 % so the count stays sane */
+		soc = 0;
+		sc2723_fgu_anchor(fgu, 1);
+	} else {
+		/* count used up but the OCV is not empty (yet): show 1 % */
+		soc = max(soc, 1);
+		if (soc == 100 || soc_cc < 1)
+			sc2723_fgu_anchor(fgu, soc);
+	}
+
+	if (trace)
+		dev_info(fgu->dev,
+			 "V %d mV I %d mA OCV %d mV count %d %% shown %d %% zero_cnt %d %s\n",
+			 uv / 1000, ua / 1000, ocv / 1000, soc_cc, soc,
+			 fgu->zero_cnt, discharging ? "discharging" : "supplied");
+
+	/*
+	 * By the current: in its 500 mA USB mode the charger can supply less
+	 * than the tablet draws, then the battery discharges while plugged in.
+	 */
+	if (full)
+		status = POWER_SUPPLY_STATUS_FULL;
+	else if (ua > 20000)
+		status = POWER_SUPPLY_STATUS_CHARGING;
+	else if (!supplied || ua < -20000)
+		status = POWER_SUPPLY_STATUS_DISCHARGING;
+	else if (soc >= 99)
+		status = POWER_SUPPLY_STATUS_FULL;
+	else
+		status = POWER_SUPPLY_STATUS_NOT_CHARGING;
+
+	if (fgu->temp_chan && !sc2723_fgu_read_temp(fgu, &fgu->temp) &&
+	    fgu->temp_limits)
+		sc2723_fgu_temp_limits(fgu, fgu->temp);
+
+	if (soc != fgu->soc)
+		sc2723_fgu_save(soc);
+	if (soc != fgu->soc || status != fgu->status) {
+		fgu->soc = soc;
+		fgu->status = status;
+		power_supply_changed(fgu->psy);
+	}
+}
+
+static void sc2723_fgu_work(struct work_struct *work)
+{
+	struct sc2723_fgu *fgu = container_of(work, struct sc2723_fgu,
+					      work.work);
+
+	sc2723_fgu_update(fgu);
+	queue_delayed_work(system_dfl_wq, &fgu->work,
+			   msecs_to_jiffies(FGU_POLL_MS));
+}
+
+static int sc2723_fgu_get_property(struct power_supply *psy,
+				   enum power_supply_property psp,
+				   union power_supply_propval *val)
+{
+	struct sc2723_fgu *fgu = power_supply_get_drvdata(psy);
+	int raw, curt;
+	s32 cc;
+
+	/* registering the supply already queries it */
+	if (!READ_ONCE(fgu->ready))
+		return -ENODATA;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = fgu->status;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		raw = fgu_read(FGU_VOLT_VAL);
+		if (raw < 0)
+			return raw;
+		val->intval = fgu_uv(fgu, raw & 0x1fff);
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		raw = fgu_read(FGU_CURT_VAL);
+		if (raw < 0)
+			return raw;
+		val->intval = fgu_ua(fgu, raw & 0x3fff);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		raw = fgu_read(FGU_VOLT_VAL);
+		curt = fgu_read(FGU_CURT_VAL);
+		if (raw < 0 || curt < 0)
+			return -EIO;
+		val->intval = sc2723_fgu_ocv_uv(fgu, fgu_uv(fgu, raw & 0x1fff),
+						fgu_ua(fgu, curt & 0x3fff));
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = fgu->soc;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		if (sc2723_fgu_clbcnt(&cc))
+			return -EIO;
+		val->intval = fgu->info->charge_full_design_uah / 100 * fgu->soc0 +
+			      fgu_cc_to_uah(fgu, sign_extend32(cc - fgu->cc0, 29));
+		val->intval = clamp(val->intval, 0,
+				    fgu->info->charge_full_design_uah);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+	/*
+	 * No capacity learning (yet): full is the design value. Android's
+	 * battery stats take the capacity from charge_full when there is
+	 * one, else from power_profile.xml (07.11.: "2 mAh").
+	 */
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+		val->intval = fgu->info->charge_full_design_uah;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = fgu->info->voltage_min_design_uv;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = fgu->info->constant_charge_voltage_max_uv;
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		if (!fgu->temp_chan)
+			return -ENODATA;
+		val->intval = fgu->temp;
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		if (!fgu->temp_chan || !fgu->temp_limits)
+			val->intval = POWER_SUPPLY_HEALTH_UNKNOWN;
+		else if (!fgu->inhibited && fgu->temp > fgu->stop_lo &&
+			 fgu->temp < fgu->stop_hi)
+			val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		else if (fgu->temp > (fgu->resume_lo + fgu->resume_hi) / 2)
+			val->intval = POWER_SUPPLY_HEALTH_OVERHEAT;
+		else
+			val->intval = POWER_SUPPLY_HEALTH_COLD;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static void sc2723_fgu_external_power_changed(struct power_supply *psy)
+{
+	struct sc2723_fgu *fgu = power_supply_get_drvdata(psy);
+
+	if (READ_ONCE(fgu->ready))
+		mod_delayed_work(system_dfl_wq, &fgu->work,
+				 msecs_to_jiffies(1000));
+}
+
+static const enum power_supply_property sc2723_fgu_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_OCV,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_HEALTH,
+};
+
+static const struct power_supply_desc sc2723_fgu_desc = {
+	.name = "battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = sc2723_fgu_props,
+	.num_properties = ARRAY_SIZE(sc2723_fgu_props),
+	.get_property = sc2723_fgu_get_property,
+	.external_power_changed = sc2723_fgu_external_power_changed,
+};
+
+static void sc2723_fgu_stop(void *data)
+{
+	struct sc2723_fgu *fgu = data;
+
+	WRITE_ONCE(fgu->ready, false);
+	cancel_delayed_work_sync(&fgu->work);
+}
+
+static int sc2723_fgu_probe_temp(struct sc2723_fgu *fgu)
+{
+	struct device *dev = fgu->dev;
+	s32 lim[2];
+	int n, ret;
+
+	fgu->temp_chan = devm_iio_channel_get(dev, "bat-temp");
+	if (IS_ERR(fgu->temp_chan)) {
+		ret = PTR_ERR(fgu->temp_chan);
+		fgu->temp_chan = NULL;
+		return ret == -ENODEV ? 0 :
+		       dev_err_probe(dev, ret, "no battery temperature\n");
+	}
+
+	n = device_property_count_u32(dev, "sprd,bat-temp-table");
+	if (n < 4 || n % 2)
+		return dev_err_probe(dev, -EINVAL, "bad sprd,bat-temp-table\n");
+	fgu->temp_table = devm_kcalloc(dev, n, sizeof(u32), GFP_KERNEL);
+	if (!fgu->temp_table)
+		return -ENOMEM;
+	ret = device_property_read_u32_array(dev, "sprd,bat-temp-table",
+					     fgu->temp_table, n);
+	if (ret)
+		return ret;
+	fgu->temp_points = n / 2;
+
+	if (device_property_read_u32_array(dev, "sprd,charge-stop-celsius",
+					   (u32 *)lim, 2))
+		return 0;
+	fgu->stop_lo = lim[0] * 10;
+	fgu->stop_hi = lim[1] * 10;
+	if (device_property_read_u32_array(dev, "sprd,charge-resume-celsius",
+					   (u32 *)lim, 2))
+		return 0;
+	fgu->resume_lo = lim[0] * 10;
+	fgu->resume_hi = lim[1] * 10;
+	fgu->temp_limits = true;
+	return 0;
+}
+
+static int sc2723_fgu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct power_supply_config cfg = {};
+	struct sc2723_fgu *fgu;
+	int volt, curt, uv, ua, ocv, soc, saved, max_diff, ret;
+	u32 r_real = 20000;
+
+	fgu = devm_kzalloc(dev, sizeof(*fgu), GFP_KERNEL);
+	if (!fgu)
+		return -ENOMEM;
+	fgu->dev = dev;
+	INIT_DELAYED_WORK(&fgu->work, sc2723_fgu_work);
+
+	/* no-ops after the bootloader, which enables the FGU every boot */
+	ret = sprd_adi_update(GLB_ARM_MODULE_EN, 0, GLB_FGU_EN);
+	if (!ret)
+		ret = sprd_adi_update(GLB_RTC_CLK_EN, 0, GLB_RTC_FGU_EN);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot enable the FGU\n");
+
+	device_property_read_u32(dev, "sprd,calib-resistance-micro-ohms",
+				 &r_real);
+	sc2723_fgu_calibrate(fgu, r_real);
+
+	ret = sc2723_fgu_probe_temp(fgu);
+	if (ret)
+		return ret;
+	if (fgu->temp_chan && !sc2723_fgu_read_temp(fgu, &fgu->temp))
+		dev_info(dev, "battery %d.%d C\n", fgu->temp / 10,
+			 abs(fgu->temp % 10));
+
+	cfg.drv_data = fgu;
+	cfg.fwnode = dev_fwnode(dev);
+	fgu->psy = devm_power_supply_register(dev, &sc2723_fgu_desc, &cfg);
+	if (IS_ERR(fgu->psy))
+		return dev_err_probe(dev, PTR_ERR(fgu->psy),
+				     "cannot register the battery\n");
+
+	ret = power_supply_get_battery_info(fgu->psy, &fgu->info);
+	if (ret)
+		return dev_err_probe(dev, ret, "no monitored-battery\n");
+	if (fgu->info->charge_full_design_uah <= 0 ||
+	    fgu->info->constant_charge_voltage_max_uv <= 0 ||
+	    fgu->info->voltage_min_design_uv <= 0 ||
+	    !fgu->info->ocv_table_size[0])
+		return dev_err_probe(dev, -EINVAL, "incomplete battery data\n");
+	fgu->rint_mohm = fgu->info->factory_internal_resistance_uohm > 0 ?
+			 fgu->info->factory_internal_resistance_uohm / 1000 : 0;
+
+	/*
+	 * Start from the saved capacity, or from the OCV (V - I * R_int)
+	 * when there is none or it is stale, e.g. after charging while off.
+	 */
+	volt = fgu_read(FGU_VOLT_VAL);
+	curt = fgu_read(FGU_CURT_VAL);
+	saved = fgu_read(FGU_USER_AREA);
+	if (volt < 0 || curt < 0 || saved < 0)
+		return dev_err_probe(dev, -EIO, "cannot read the FGU\n");
+	uv = fgu_uv(fgu, volt & 0x1fff);
+	ua = fgu_ua(fgu, curt & 0x3fff);
+	ocv = sc2723_fgu_ocv_uv(fgu, uv, ua);
+	soc = clamp(power_supply_batinfo_ocv2cap(fgu->info, ocv, 20), 0, 100);
+	fgu->soc = soc;
+	max_diff = soc < FGU_EDGE_SOC || soc > 100 - FGU_EDGE_SOC ?
+		   FGU_SAVED_MAX_DIFF_EDGE : FGU_SAVED_MAX_DIFF;
+	if (FIELD_GET(USER_AREA_TYPE, saved) == USER_AREA_TYPE_NORMAL &&
+	    FIELD_GET(USER_AREA_SOC, saved) <= 100 &&
+	    abs((int)FIELD_GET(USER_AREA_SOC, saved) - soc) <= max_diff)
+		fgu->soc = FIELD_GET(USER_AREA_SOC, saved);
+	fgu->status = POWER_SUPPLY_STATUS_UNKNOWN;
+	sc2723_fgu_anchor(fgu, fgu->soc);
+	sc2723_fgu_save(fgu->soc);
+	dev_info(dev,
+		 "VOLT %d = %d mV, CURT %d = %d mA, OCV %d mV = %d %%, CLBCNT %08x, USER_AREA %04x, start %d %%\n",
+		 volt, uv / 1000, curt, ua / 1000, ocv / 1000, soc,
+		 fgu->cc0, saved, fgu->soc);
+
+	/* runs before the supply is unregistered (devm order) */
+	ret = devm_add_action_or_reset(dev, sc2723_fgu_stop, fgu);
+	if (ret)
+		return ret;
+	WRITE_ONCE(fgu->ready, true);
+	queue_delayed_work(system_dfl_wq, &fgu->work, 0);
+	return 0;
+}
+
+static const struct of_device_id sc2723_fgu_of_match[] = {
+	{ .compatible = "sprd,sc2723-fgu-polled" },
+	{ }
+};
+
+static struct platform_driver sc2723_fgu_driver = {
+	.probe = sc2723_fgu_probe,
+	.driver = {
+		.name = "sc2723-fgu-polled",
+		.of_match_table = sc2723_fgu_of_match,
+	},
+};
+builtin_platform_driver(sc2723_fgu_driver);
diff --git a/arch/arm/mach-sprd/sc2723-ldo.c b/arch/arm/mach-sprd/sc2723-ldo.c
new file mode 100644
index 000000000..734fee320
--- /dev/null
+++ b/arch/arm/mach-sprd/sc2723-ldo.c
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * One LDO of the SC2723 PMIC as a regulator, one device tree node each:
+ * a power-down bit ("sprd,pd-reg" = <offset bit>, 1 = off) and a voltage
+ * field ("sprd,vsel-reg" = <offset mask>), V = min + n * step with the
+ * vendor's defaults of 1.2 V and 10 mV. Registers from the vendor 3.10
+ * driver (drivers/regulator/sc2723-regulator_dt.c) and vendor device tree.
+ *
+ * The power-down and voltage registers are shared between LDOs (and with
+ * mach-sprd/usb-bringup.c), so every write is a read-modify-write under
+ * the ADI lock. The calibration trim the vendor applies is left alone.
+ *
+ * Bring-up glue until mainline sc2731-regulator (same idea, other
+ * offsets) learns the SC2723 on top of an sc27xx MFD.
+ */
+
+#include <linux/bits.h>
+#include <linux/mod_devicetable.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#include "adi.h"
+
+struct sc2723_ldo {
+	u32 pd_reg, pd_mask;
+	u32 vsel_reg, vsel_mask, vsel_shift;
+	struct regulator_desc desc;
+};
+
+static int sc2723_ldo_enable(struct regulator_dev *rdev)
+{
+	struct sc2723_ldo *ldo = rdev_get_drvdata(rdev);
+
+	return sprd_adi_update(ldo->pd_reg, ldo->pd_mask, 0);
+}
+
+static int sc2723_ldo_disable(struct regulator_dev *rdev)
+{
+	struct sc2723_ldo *ldo = rdev_get_drvdata(rdev);
+
+	return sprd_adi_update(ldo->pd_reg, 0, ldo->pd_mask);
+}
+
+static int sc2723_ldo_is_enabled(struct regulator_dev *rdev)
+{
+	struct sc2723_ldo *ldo = rdev_get_drvdata(rdev);
+	u32 val;
+	int ret;
+
+	ret = sprd_adi_read(ldo->pd_reg, &val);
+	return ret ?: !(val & ldo->pd_mask);
+}
+
+static int sc2723_ldo_get_voltage_sel(struct regulator_dev *rdev)
+{
+	struct sc2723_ldo *ldo = rdev_get_drvdata(rdev);
+	u32 val;
+	int ret;
+
+	ret = sprd_adi_read(ldo->vsel_reg, &val);
+	return ret ?: (int)((val & ldo->vsel_mask) >> ldo->vsel_shift);
+}
+
+static int sc2723_ldo_set_voltage_sel(struct regulator_dev *rdev,
+				      unsigned int sel)
+{
+	struct sc2723_ldo *ldo = rdev_get_drvdata(rdev);
+
+	return sprd_adi_update(ldo->vsel_reg, ldo->vsel_mask,
+			       sel << ldo->vsel_shift);
+}
+
+static const struct regulator_ops sc2723_ldo_ops = {
+	.enable = sc2723_ldo_enable,
+	.disable = sc2723_ldo_disable,
+	.is_enabled = sc2723_ldo_is_enabled,
+	.list_voltage = regulator_list_voltage_linear,
+	.map_voltage = regulator_map_voltage_linear,
+	.get_voltage_sel = sc2723_ldo_get_voltage_sel,
+	.set_voltage_sel = sc2723_ldo_set_voltage_sel,
+};
+
+static int sc2723_ldo_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct regulator_config cfg = {};
+	struct regulator_dev *rdev;
+	struct sc2723_ldo *ldo;
+	u32 pd[2], vsel[2], min_uv = 1200000, step_uv = 10000;
+
+	ldo = devm_kzalloc(dev, sizeof(*ldo), GFP_KERNEL);
+	if (!ldo)
+		return -ENOMEM;
+
+	if (of_property_read_u32_array(np, "sprd,pd-reg", pd, 2) ||
+	    of_property_read_u32_array(np, "sprd,vsel-reg", vsel, 2) ||
+	    pd[1] > 15 || !vsel[1])
+		return dev_err_probe(dev, -EINVAL, "bad sprd,pd-reg/vsel-reg\n");
+	of_property_read_u32(np, "sprd,min-microvolt", &min_uv);
+	of_property_read_u32(np, "sprd,step-microvolt", &step_uv);
+
+	ldo->pd_reg = pd[0];
+	ldo->pd_mask = BIT(pd[1]);
+	ldo->vsel_reg = vsel[0];
+	ldo->vsel_mask = vsel[1];
+	ldo->vsel_shift = __ffs(vsel[1]);
+
+	ldo->desc.name = np->name;
+	ldo->desc.type = REGULATOR_VOLTAGE;
+	ldo->desc.owner = THIS_MODULE;
+	ldo->desc.ops = &sc2723_ldo_ops;
+	ldo->desc.min_uV = min_uv;
+	ldo->desc.uV_step = step_uv;
+	ldo->desc.n_voltages = (vsel[1] >> ldo->vsel_shift) + 1;
+	ldo->desc.enable_time = 1000;
+
+	cfg.dev = dev;
+	cfg.of_node = np;
+	cfg.driver_data = ldo;
+	cfg.init_data = of_get_regulator_init_data(dev, np, &ldo->desc);
+	if (!cfg.init_data)
+		return -ENOMEM;
+
+	rdev = devm_regulator_register(dev, &ldo->desc, &cfg);
+	return PTR_ERR_OR_ZERO(rdev);
+}
+
+static const struct of_device_id sc2723_ldo_of_match[] = {
+	{ .compatible = "sprd,sc2723-ldo" },
+	{ }
+};
+
+static struct platform_driver sc2723_ldo_driver = {
+	.probe = sc2723_ldo_probe,
+	.driver = {
+		.name = "sc2723-ldo",
+		.of_match_table = sc2723_ldo_of_match,
+	},
+};
+builtin_platform_driver(sc2723_ldo_driver);
diff --git a/arch/arm/mach-sprd/sc2723-pmic.c b/arch/arm/mach-sprd/sc2723-pmic.c
new file mode 100644
index 000000000..a8d93b219
--- /dev/null
+++ b/arch/arm/mach-sprd/sc2723-pmic.c
@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The SC2723 PMIC as a regmap over the ADI helpers, with its interrupt
+ * controller (ANA_INT at slave offset 0x380, GIC SPI 38) as a regmap-irq
+ * chip, and the child nodes populated on top. This is what mainline
+ * sprd-sc27xx-spi does for the SC2730/SC2731 over spi-sprd-adi, so the
+ * mainline sc27xx RTC and PMIC EIC drivers work unchanged on the SC2723:
+ * their register blocks match (checked against the vendor 3.10 drivers
+ * and on the hardware).
+ *
+ * Interrupt sources (vendor __irqs-sc8830.h): 0 ADC, 1 GPIO, 2 RTC,
+ * 3 watchdog, 4 FGU, 5 EIC, 6 headset button, 7 audio protect,
+ * 8 calibration, 9 TPC/thermal, 10 DCDC overtemperature.
+ *
+ * Bring-up glue: the FGU, ADC and LDO glue still use the ADI helpers
+ * directly, which is fine since every access goes through the same lock.
+ */
+
+#include <linux/bits.h>
+#include <linux/interrupt.h>
+#include <linux/mod_devicetable.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
+#include <linux/regmap.h>
+
+#include "adi.h"
+
+#define SC2723_INT(x)		(0x380 + (x))
+#define INT_MASK_STATUS		SC2723_INT(0x00)
+#define INT_EN			SC2723_INT(0x08)
+#define SC2723_NR_IRQS		11
+
+struct sc2723_pmic {
+	struct regmap_irq irqs[SC2723_NR_IRQS];
+	struct regmap_irq_chip irq_chip;
+	struct regmap_irq_chip_data *irq_data;
+	int irq;
+};
+
+static int sc2723_pmic_reg_read(void *ctx, unsigned int reg,
+				unsigned int *val)
+{
+	return sprd_adi_read(reg, val);
+}
+
+static int sc2723_pmic_reg_write(void *ctx, unsigned int reg,
+				 unsigned int val)
+{
+	return sprd_adi_write(reg, val);
+}
+
+static const struct regmap_config sc2723_pmic_regmap_config = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.max_register = 0xffc,
+	.reg_read = sc2723_pmic_reg_read,
+	.reg_write = sc2723_pmic_reg_write,
+};
+
+static int sc2723_pmic_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sc2723_pmic *pmic;
+	struct regmap *map;
+	int i, ret;
+
+	pmic = devm_kzalloc(dev, sizeof(*pmic), GFP_KERNEL);
+	if (!pmic)
+		return -ENOMEM;
+	platform_set_drvdata(pdev, pmic);
+
+	pmic->irq = platform_get_irq(pdev, 0);
+	if (pmic->irq < 0)
+		return pmic->irq;
+
+	map = devm_regmap_init(dev, NULL, pmic, &sc2723_pmic_regmap_config);
+	if (IS_ERR(map))
+		return dev_err_probe(dev, PTR_ERR(map), "cannot init regmap\n");
+
+	for (i = 0; i < SC2723_NR_IRQS; i++)
+		pmic->irqs[i].mask = BIT(i);
+	pmic->irq_chip.name = dev_name(dev);
+	pmic->irq_chip.status_base = INT_MASK_STATUS;
+	pmic->irq_chip.unmask_base = INT_EN;
+	pmic->irq_chip.num_regs = 1;
+	pmic->irq_chip.irqs = pmic->irqs;
+	pmic->irq_chip.num_irqs = SC2723_NR_IRQS;
+
+	/* masks everything first: the bootloader leaves all sources enabled */
+	ret = devm_regmap_add_irq_chip(dev, map, pmic->irq, IRQF_ONESHOT, 0,
+				       &pmic->irq_chip, &pmic->irq_data);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot add the irq chip\n");
+
+	ret = devm_device_init_wakeup(dev);
+	if (ret)
+		return ret;
+
+	return devm_of_platform_populate(dev);
+}
+
+/* power key, volume down and the RTC alarm all come in through here */
+static int sc2723_pmic_suspend(struct device *dev)
+{
+	struct sc2723_pmic *pmic = dev_get_drvdata(dev);
+
+	if (device_may_wakeup(dev))
+		enable_irq_wake(pmic->irq);
+	return 0;
+}
+
+static int sc2723_pmic_resume(struct device *dev)
+{
+	struct sc2723_pmic *pmic = dev_get_drvdata(dev);
+
+	if (device_may_wakeup(dev))
+		disable_irq_wake(pmic->irq);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(sc2723_pmic_pm_ops,
+				sc2723_pmic_suspend, sc2723_pmic_resume);
+
+static const struct of_device_id sc2723_pmic_of_match[] = {
+	{ .compatible = "sprd,sc2723-adi-pmic" },
+	{ }
+};
+
+static struct platform_driver sc2723_pmic_driver = {
+	.probe = sc2723_pmic_probe,
+	.driver = {
+		.name = "sc2723-adi-pmic",
+		.of_match_table = sc2723_pmic_of_match,
+		.pm = pm_sleep_ptr(&sc2723_pmic_pm_ops),
+	},
+};
+builtin_platform_driver(sc2723_pmic_driver);
diff --git a/arch/arm/mach-sprd/sc7730.c b/arch/arm/mach-sprd/sc7730.c
new file mode 100644
index 000000000..68bd88d0a
--- /dev/null
+++ b/arch/arm/mach-sprd/sc7730.c
@@ -0,0 +1,245 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Spreadtrum SC7730: start the system counter before the timers probe.
+ *
+ * The ARM architected timers of the Cortex-A7 cluster count the CoreSight
+ * timestamp generator TS1 (TS0 also runs, but does not reach the cores),
+ * which is off after reset: AON_APB EB0 bit 29 gates it, AON_CLK
+ * CA7_TS_CFG bits 1:0 select its clock (1 = 26 MHz), CNTCR bit 0 starts
+ * it, and the timestamp ports have a low-power handshake that has to
+ * request them active (AON_APB TS_CFG CSYSREQ bits 8/10/12). Neither
+ * bootloader stage touches any of this; the vendor kernel never used the
+ * architected timer at all.
+ *
+ * The bootloader also leaves the kernel in the Secure world (NSACR reads 0
+ * with VFP working), so CNTFRQ is ours to set, on every CPU.
+ *
+ * With the SoC's automatic core clock gating (AP_AHB AP_SYS_AUTO_SLEEP_CFG
+ * bit 0, on after reset) the clock of a core in WFI stops, and with it the
+ * comparators of its architected timers: neither the PPI nor the SPI copy
+ * fires, and an idle CPU only wakes for some other interrupt (100 sleeps
+ * of 10 ms took 124 s). Keep the core clocks running in WFI; the vendor
+ * kernel does the same on some scx35 revisions.
+ *
+ * Suspend to "mem" is the vendor's standby for now: the PM core takes
+ * CPU1-3 offline, which powers them down (platsmp.c), and CPU0 waits in
+ * WFI for a wakeup interrupt. DDR, the GIC and the counter stay powered.
+ * While CPU0 waits, the DDR controller (Synopsys uMCTL2) may put the DRAM
+ * into self-refresh after its idle timeout (PWRTMG, set by the SPL) and
+ * takes it out on the next access, as in the vendor's suspend: only PWRCTL
+ * changes, no code runs from IRAM. Measured with the panel off: 89 -> 88
+ * mA; the controller already powers the DRAM down when idle. The vendor's
+ * light-sleep bits (MCU_PAUSE SYS/LIGHT_SLEEP with the AON wake mux) gave
+ * nothing measurable while peripheral clocks run, and the core clock
+ * auto gate stops the CPU's view of the system counter (lost time). The
+ * vendor's deep sleep (peripheral gating, CA7 power-down, DDR PHY
+ * retention, resume from IRAM) is not there yet.
+ *
+ * The CPU OPP table goes beyond the vendor's 1300 MHz (overclocking steps
+ * checked on a single unit), so every new cpufreq policy gets a maximum
+ * of 1300 MHz before its governor starts. User space can move it through
+ * /sys/module/sc7730/parameters/cpu_max_khz.
+ */
+
+#include <linux/bits.h>
+#include <linux/clk-provider.h>
+#include <linux/clocksource.h>
+#include <linux/cpufreq.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/pm_qos.h>
+#include <linux/printk.h>
+#include <linux/suspend.h>
+
+#include <asm/mach/arch.h>
+#include <asm/proc-fns.h>
+
+#include "sc7730.h"
+
+#define AON_APB_PHYS		0x402e0000
+#define AON_APB_EB0		0x00
+#define AON_EB0_CA7_TS1		BIT(29)
+#define AON_EB0_IPI		BIT(21)	/* IPI registers: AP <-> modem interrupts */
+#define AON_APB_TS_CFG		0x28
+#define TS_CFG_CSYSREQ		(BIT(8) | BIT(10) | BIT(12))
+#define AON_CLK_CA7_TS_CFG	0x402d004c
+#define CA7_TS_SEL_26M		1
+#define CA7_TS1_PHYS		0x40410000
+#define TS_CNTCR_EN		BIT(0)
+#define AP_AHB_PHYS		0x20d00000
+#define UMCTL2_PHYS		0x30000000
+#define UMCTL2_PWRCTL		0x30
+#define PWRCTL_SELFREF_EN	BIT(0)
+#define PWRCTL_POWERDOWN_EN	BIT(1)
+#define AP_SYS_AUTO_SLEEP_CFG	0x10
+#define CA7_CORE_AUTO_GATE_EN	BIT(0)
+
+void sc7730_set_cntfrq(void)
+{
+	asm volatile("mcr p15, 0, %0, c14, c0, 0" : : "r" (SC7730_CNTFRQ));
+	isb();
+}
+
+static void __init sc7730_counter_init(void)
+{
+	void __iomem *aon = ioremap(AON_APB_PHYS, 0x30);
+	void __iomem *clk = ioremap(AON_CLK_CA7_TS_CFG, 4);
+	void __iomem *ts1 = ioremap(CA7_TS1_PHYS, 0x10);
+	void __iomem *ahb = ioremap(AP_AHB_PHYS, 0x20);
+
+	if (ahb) {
+		writel_relaxed(readl_relaxed(ahb + AP_SYS_AUTO_SLEEP_CFG) &
+			       ~CA7_CORE_AUTO_GATE_EN, ahb + AP_SYS_AUTO_SLEEP_CFG);
+		iounmap(ahb);
+	}
+
+	if (aon && clk && ts1) {
+		/* the IPI block hangs the bus when its clock is off (SIPC, modem) */
+		writel_relaxed(readl_relaxed(aon + AON_APB_EB0) | AON_EB0_CA7_TS1 | AON_EB0_IPI,
+			       aon + AON_APB_EB0);
+		writel_relaxed((readl_relaxed(clk) & ~3) | CA7_TS_SEL_26M, clk);
+		writel_relaxed(readl_relaxed(aon + AON_APB_TS_CFG) | TS_CFG_CSYSREQ,
+			       aon + AON_APB_TS_CFG);
+		writel(readl_relaxed(ts1) | TS_CNTCR_EN, ts1);
+		sc7730_set_cntfrq();
+	} else {
+		pr_err("sc7730: cannot map the system counter\n");
+	}
+
+	if (ts1)
+		iounmap(ts1);
+	if (clk)
+		iounmap(clk);
+	if (aon)
+		iounmap(aon);
+}
+
+static void __init sc7730_init_time(void)
+{
+	sc7730_counter_init();
+	of_clk_init(NULL);
+	timer_probe();
+}
+
+#ifdef CONFIG_SUSPEND
+static void __iomem *sc7730_umctl2;
+
+static bool ddr_selfref = true;
+module_param(ddr_selfref, bool, 0644);
+MODULE_PARM_DESC(ddr_selfref, "DDR self-refresh while suspended");
+
+static int sc7730_suspend_enter(suspend_state_t state)
+{
+	void __iomem *pwrctl = sc7730_umctl2 + UMCTL2_PWRCTL;
+	bool selfref = sc7730_umctl2 && READ_ONCE(ddr_selfref);
+	u32 old = 0;
+
+	/* the vendor's suspend: self-refresh instead of power-down */
+	if (selfref) {
+		old = readl(pwrctl);
+		writel((old & ~PWRCTL_POWERDOWN_EN) | PWRCTL_SELFREF_EN, pwrctl);
+	}
+	cpu_do_idle();
+	if (selfref)
+		writel(old, pwrctl);
+	return 0;
+}
+
+/*
+ * WFI ends for any pending interrupt, also one that is not a wakeup
+ * source (a touch controller losing power toggles its line on the way
+ * down). Once the core has looked at it, after resuming as far as the
+ * early phase, sleep again unless it was a wakeup. Handling interrupts
+ * inside ->enter() instead, with timekeeping suspended, hung the resume.
+ */
+static bool sc7730_suspend_again(void)
+{
+	return !pm_wakeup_pending();
+}
+
+static const struct platform_suspend_ops sc7730_suspend_ops = {
+	.valid		= suspend_valid_only_mem,
+	.enter		= sc7730_suspend_enter,
+	.suspend_again	= sc7730_suspend_again,
+};
+
+static void __init sc7730_init_late(void)
+{
+	sc7730_umctl2 = ioremap(UMCTL2_PHYS, 0x100);
+	suspend_set_ops(&sc7730_suspend_ops);
+}
+#else
+#define sc7730_init_late	NULL
+#endif
+
+#ifdef CONFIG_CPU_FREQ
+static unsigned int cpu_max_khz = 1300000;
+static struct freq_qos_request cpu_max_req;
+static struct cpufreq_policy *cpu_max_policy;
+static DEFINE_MUTEX(cpu_max_lock);
+
+static int sc7730_cpu_max_set(const char *val, const struct kernel_param *kp)
+{
+	int ret;
+
+	mutex_lock(&cpu_max_lock);
+	ret = param_set_uint(val, kp);
+	if (!ret && cpu_max_policy)
+		ret = freq_qos_update_request(&cpu_max_req, cpu_max_khz);
+	mutex_unlock(&cpu_max_lock);
+	return ret < 0 ? ret : 0;
+}
+
+static const struct kernel_param_ops sc7730_cpu_max_ops = {
+	.set = sc7730_cpu_max_set,
+	.get = param_get_uint,
+};
+module_param_cb(cpu_max_khz, &sc7730_cpu_max_ops, &cpu_max_khz, 0644);
+MODULE_PARM_DESC(cpu_max_khz, "CPU frequency limit in kHz (vendor maximum 1300000)");
+
+static int sc7730_cpufreq_notify(struct notifier_block *nb,
+				 unsigned long event, void *data)
+{
+	struct cpufreq_policy *policy = data;
+
+	mutex_lock(&cpu_max_lock);
+	if (event == CPUFREQ_CREATE_POLICY && !cpu_max_policy) {
+		if (freq_qos_add_request(&policy->constraints, &cpu_max_req,
+					 FREQ_QOS_MAX, cpu_max_khz) >= 0)
+			cpu_max_policy = policy;
+	} else if (event == CPUFREQ_REMOVE_POLICY && policy == cpu_max_policy) {
+		freq_qos_remove_request(&cpu_max_req);
+		cpu_max_policy = NULL;
+	}
+	mutex_unlock(&cpu_max_lock);
+	return NOTIFY_OK;
+}
+
+static struct notifier_block sc7730_cpufreq_nb = {
+	.notifier_call = sc7730_cpufreq_notify,
+};
+
+/* before cpufreq-dt probes at device_initcall */
+static int __init sc7730_cpufreq_limit_init(void)
+{
+	if (!of_machine_is_compatible("sprd,sc7730"))
+		return 0;
+	return cpufreq_register_notifier(&sc7730_cpufreq_nb,
+					 CPUFREQ_POLICY_NOTIFIER);
+}
+arch_initcall(sc7730_cpufreq_limit_init);
+#endif
+
+static const char *const sc7730_dt_compat[] __initconst = {
+	"sprd,sc7730",
+	NULL
+};
+
+DT_MACHINE_START(SPRD_SC7730, "Spreadtrum SC7730")
+	.dt_compat	= sc7730_dt_compat,
+	.init_time	= sc7730_init_time,
+	.init_late	= sc7730_init_late,
+MACHINE_END
diff --git a/arch/arm/mach-sprd/sc7730.h b/arch/arm/mach-sprd/sc7730.h
