#!/bin/sh
sysctl -w net.ipv4.ip_default_ttl=66 >/dev/null 2>&1 || true
ip link set usb0 up 2>/dev/null || true
ip addr del 10.55.0.1/24 dev usb0 2>/dev/null || true
ip addr add 192.168.7.2/24 dev usb0 2>/dev/null || true
ip route replace default via 192.168.7.1 dev usb0 src 192.168.7.2 2>/dev/null || true
cat > /etc/resolv.conf << "DNS"
nameserver 192.168.7.1
nameserver 1.1.1.1
nameserver 8.8.8.8
DNS
